<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/green_1"/>
            <corners
                android:topLeftRadius="@dimen/corner_big"
                android:bottomRightRadius="@dimen/corner_big"/>
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/corner_big"
                android:bottomRightRadius="@dimen/corner_big"/>
            <stroke
                android:width="1dp"
                android:color="@color/white"
                android:dashWidth="4dp"
                android:dashGap="4dp"/>
        </shape>
    </item>
</layer-list>
