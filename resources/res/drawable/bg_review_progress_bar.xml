<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="?attr/colorSurface2"/>
            <corners android:radius="@dimen/review_progress_bar_radius"/>
            <size android:height="@dimen/review_progress_bar_height"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="?attr/colorAdditional2"/>
                <corners android:radius="@dimen/review_progress_bar_radius"/>
                <size android:height="@dimen/review_progress_bar_height"/>
            </shape>
        </clip>
    </item>
</layer-list>
