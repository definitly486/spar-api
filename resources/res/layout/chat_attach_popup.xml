<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/permission_popup_background"
    android:padding="@dimen/content_margin_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center"
        android:id="@+id/tvChatPopupHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/chat_popup_header"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvChatPopupBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_12"
        android:text="@string/chat_popup_message"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Regular.Heading7"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ibChatUseCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_28"
        android:text="@string/chat_popup_use_camera"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ibChatUseGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/chat_popup_from_gallery"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/ibChatCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cancel"
        style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
</LinearLayout>
