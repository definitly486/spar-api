<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/content_margin_16">
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/btn_dismiss_dialog"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/content_margin_16"
            android:layout_height="@dimen/content_margin_16"
            android:src="@drawable/ic_close_black"/>
    </FrameLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/build_your_combo"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Emphasis.Heading3"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_weight="1"
        android:isScrollContainer="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ru.myspar.legacy.presentation.dialogs.comboset.buildyourcombo.views.ComboProductsListTitle
                android:id="@+id/titleProductsFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/content_margin_16"
                app:comboListMessage="@string/this_product_is_included_in_the_combo_by_default"
                app:comboListTitle="@string/select_the_first_item"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rvProductsFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <ru.myspar.legacy.presentation.dialogs.comboset.buildyourcombo.views.ComboProductsListTitle
                android:id="@+id/titleProductsSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"
                android:layout_marginHorizontal="@dimen/content_margin_16"
                app:comboListMessage="@string/this_product_is_included_in_the_combo_by_default"
                app:comboListTitle="@string/select_the_second_item"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rvProductsSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToBasket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/add_products_to_basket"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
</LinearLayout>
