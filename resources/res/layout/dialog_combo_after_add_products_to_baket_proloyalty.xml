<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/content_margin_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_specific_purchase_success_retry_title"
            style="@style/Emphasis.Heading5"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons1"
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            android:text="@string/proloyalty_specific_purchase_success_retry_subtitle"
            android:fontFamily="@font/sf_pro_display"
            style="@style/Android.Subtitle2"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPositive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_16"
            android:text="@string/proloyalty_specific_purchase_success_retry_return"
            style="@style/Button.Primary56.ButtonLargeBold16"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNegative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_16"
            android:text="@string/proloyalty_action_close"
            style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
