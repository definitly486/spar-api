<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_sheet_background"
    android:paddingTop="8dp"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <View
        android:id="@+id/curtain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Curtain"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/title_choose_pickup_place"
        app:layout_constraintTop_toBottomOf="@+id/curtain"
        style="@style/Emphasis.Heading4"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSupermarket"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/supermarket"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btnCar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/car"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSupermarket"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/footer_choose_pickup_place"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSupermarket"
        style="@style/Regular.Heading5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
