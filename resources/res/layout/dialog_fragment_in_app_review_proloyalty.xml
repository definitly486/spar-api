<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootInAppReview"
    android:background="@drawable/bottom_sheet_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="8dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="28dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <View
        android:id="@+id/curtain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/glTop"
        style="@style/Curtain"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIconApp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@mipmap/splash_logo"
        app:layout_constraintBottom_toBottomOf="@+id/tvDescriptionApp"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="@+id/tvTitleApp"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvTitleApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/proloyalty_app_name"
        android:fontFamily="@font/sf_pro_bold"
        android:layout_marginStart="11dp"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toEndOf="@+id/ivIconApp"
        app:layout_constraintTop_toBottomOf="@+id/curtain"
        style="@style/Android.Subtitle2"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:id="@+id/tvDescriptionApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/proloyalty_title_rate"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/tvTitleApp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleApp"
        style="@style/Android.Subtitle2"/>
    <androidx.appcompat.widget.AppCompatRatingBar
        android:id="@+id/rbRatingApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:numStars="5"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:progressTint="?attr/colorPrimary"
        android:secondaryProgressTint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvDescriptionApp"
        style="@style/Widget.AppCompat.RatingBar"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="12sp"
        android:textColor="?attr/colorPrimary"
        android:id="@+id/btnCancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_action_cancel"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toStartOf="@+id/btnSubmit"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/rbRatingApp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="12sp"
        android:id="@+id/btnSubmit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_action_submit"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnCancel"
        app:layout_constraintTop_toBottomOf="@+id/rbRatingApp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvCompleteTitle"
        android:background="?attr/colorSurface"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/proloyalty_msg_thank_review"
        android:fontFamily="@font/sf_pro_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Android.Subtitle2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
