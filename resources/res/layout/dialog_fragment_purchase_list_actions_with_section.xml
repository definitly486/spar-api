<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/vCurtain"
        android:layout_marginTop="@dimen/content_margin_12"
        android:backgroundTint="?attr/colorTextIcons4"
        style="@style/Curtain"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_24"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remove_from_list"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        android:layout_marginVertical="@dimen/content_margin_16"
        style="@style/Button.SecondaryNegative40.ButtonLargeBold16"/>
</LinearLayout>
