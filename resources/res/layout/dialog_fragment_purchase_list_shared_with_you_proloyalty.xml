<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/vCurtain"
        android:layout_marginTop="@dimen/content_margin_12"
        android:backgroundTint="?attr/colorTextIcons4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Curtain"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_24"
        android:text="@string/proloyalty_purchases_list_shared_with_you_title"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vCurtain"
        style="@style/Emphasis.Heading3"/>
    <include
        android:id="@+id/containerPurchaseListItem"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/content_margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        layout="@layout/item_purchase_list_proloyalty"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/containerWarning"
        android:background="@drawable/bg_rounded_corners_12dp"
        android:padding="@dimen/content_margin_12"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:backgroundTint="?attr/colorSpecialSurface5"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/containerPurchaseListItem">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_attention_exclamation_mark_16"
            android:tint="?attr/colorTextStaticBlack3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tintMode="src_in"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextStaticBlack2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_purchases_list_shared_with_you_warning"
            android:layout_marginStart="@dimen/content_margin_12"
            style="@style/Regular.Heading7"/>
    </LinearLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/containerWarning"
        style="@style/Android.Body1"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSavePurchaseList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/proloyalty_purchases_list_save_list"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription"
        style="@style/Button.SecondaryNegative40.ButtonLargeBold16"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/Emphasis.Heading6"
        android:textColor="?attr/colorPrimary1"
        android:id="@+id/btnClose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/proloyalty_action_close"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textAllCaps="false"
        app:cornerRadius="32dp"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/btnSavePurchaseList"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_16"
        app:layout_constraintTop_toBottomOf="@+id/btnClose"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/content_margin_16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/content_margin_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
