<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vCurtain"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Curtain"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="32sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/cera_round_bold"
        app:layout_constraintBottom_toTopOf="@+id/ivQrCode"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vCurtain"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivQrCode"
        android:padding="8dp"
        android:layout_width="343dp"
        android:layout_height="258dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="76dp"
        app:layout_constraintBottom_toTopOf="@+id/cvDescription"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="36dp"
        android:elevation="0dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="?attr/colorSpecialSurface5"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ivProductPhoto"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="14sp"
            android:textColor="?attr/colorTextStaticBlack2"
            android:gravity="center"
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            style="@style/Regular.Heading7"/>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProductPhoto"
        android:layout_width="120dp"
        android:layout_height="104dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/proloyalty_product_photo_description"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnOpenUserQrCode"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded4dp"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvProductTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toTopOf="@+id/ivProductPhoto"
        style="@style/Regular.Heading6"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ProductPriceView
        android:id="@+id/tvProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvProductTitle"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center_vertical"
        android:id="@+id/tvOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cera_round_medium"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvProductPrice"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center_vertical"
        android:id="@+id/tvCurrencyOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_rouble"
        android:fontFamily="@font/cera_round_medium"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvOldPrice"
        app:layout_constraintStart_toEndOf="@+id/tvOldPrice"
        app:layout_constraintTop_toTopOf="@+id/tvOldPrice"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenUserQrCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_open_my_spar_card"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="8dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="28dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
