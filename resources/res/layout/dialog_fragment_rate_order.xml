<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/vCurtain"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Curtain"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/rate_order_dialog_title"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vCurtain"
        style="@style/Emphasis.Heading3"/>
    <ru.myspar.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/vRatingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        app:drawable_empty="@drawable/ic_ratingbar_empty"
        app:drawable_fill="@drawable/ic_ratingbar_fill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintVertical_bias="0"
        app:num_stars="5"
        app:rating="2"
        app:scrollable="true"
        app:star_height="40dp"
        app:star_width="40dp"
        app:step_size="1"/>
    <ru.myspar.legacy.presentation.view.DateAndPlaceView
        android:id="@+id/vDatePlace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:image_date="@drawable/ic_calendar"
        app:image_place="@drawable/ic_marker_geo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vRatingBar"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:id="@+id/tvTotalPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/rate_order_dialog_sum"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/vDatePlace"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvPriceInt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/tvPriceFract"
        app:layout_constraintTop_toTopOf="@+id/tvTotalPayment"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvPriceFract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/tvCurrency"
        app:layout_constraintTop_toTopOf="@+id/tvCurrency"
        style="@style/Emphasis.Heading7"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rouble"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvTotalPayment"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintTop_toTopOf="@+id/tvTotalPayment"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRateOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"
        android:text="@string/rate_order_button"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalPayment"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
