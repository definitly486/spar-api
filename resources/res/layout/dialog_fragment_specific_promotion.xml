<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nsvDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/activity_vertical_margin"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="28dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/activity_horizontal_margin"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="@dimen/activity_horizontal_margin"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnClose"
            android:background="@drawable/bg_rounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="?attr/colorTextStaticWhite1"
            android:backgroundTint="?attr/colorSurface4"
            app:layout_constraintBottom_toTopOf="@+id/clProductContainer"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintTop_toTopOf="@+id/glTop"
            app:srcCompat="@drawable/ic_round_close"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProductContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@+id/vQrDivider"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/btnClose">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProductPicture"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded4dp"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/tvProductTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/barrierProductPrice"
                app:layout_constraintStart_toEndOf="@+id/ivProductPicture"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="tvProductOldPrice, tvProductPrice"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons2"
                android:id="@+id/tvProductOldPrice"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                app:layout_constraintBottom_toTopOf="@+id/tvProductPrice"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/tvProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_semibold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvProductOldPrice"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/vQrDivider"
            android:layout_width="0dp"
            android:layout_height="@dimen/divider_height"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toTopOf="@+id/tvQrTitle"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/clProductContainer"
            style="@style/Divider"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:id="@+id/tvQrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/title_show_qr_code"
            android:fontFamily="@font/sf_pro_semibold"
            app:layout_constraintBottom_toTopOf="@+id/ivQrPicture"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/vQrDivider"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivQrPicture"
            android:layout_width="@dimen/size_qr"
            android:layout_height="@dimen/size_qr"
            android:layout_marginTop="16dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/qr_description"
            app:layout_constraintBottom_toTopOf="@+id/tvQrMsg"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvQrTitle"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:id="@+id/tvQrMsg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/sf_pro_display"
            app:layout_constraintBottom_toBottomOf="@+id/glBottom"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/ivQrPicture"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
