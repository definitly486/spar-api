<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_corners_12dp"
    android:layout_width="270dp"
    android:layout_height="wrap_content">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:text="@string/proloyalty_scan_go_confirmation_dialog_title"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_scan_go_confirmation_dialog_description"
        android:layout_marginHorizontal="16dp"
        style="@style/Regular.Heading7"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPurchase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_scan_go_confirmation_dialog_btn_confirm_purchase"
        android:layout_marginHorizontal="12dp"
        style="@style/ScanGoButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReturnToBasket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/proloyalty_scan_go_confirmation_dialog_btn_return_to_basket"
        android:layout_marginHorizontal="12dp"
        style="@style/ScanGoButtonSecondary"/>
</LinearLayout>
