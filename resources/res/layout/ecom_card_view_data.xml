<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/ecomCvdMotionLayout"
        android:background="@drawable/ecom_bg_card_data_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutDescription="@xml/ecom_card_view_data_anim_scene"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/ecomCvdCardNumberHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ecom_vcd_card_number"
            app:layout_constraintStart_toStartOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"
            style="@style/EcomCardNumberHint"/>
        <TextView
            android:id="@+id/ecomCvdCardNumberShortText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/EcomCardNumberShortText"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ecomCvdCardNumberLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/ecom_vcd_card_number"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/EcomCardTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ecomCvdCardNumberEditText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/EcomCardEditText.Number"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ecomCvdCardIconImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintStart_toEndOf="@+id/ecomCvdCardNumberShortText"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ecomCvdCardDateLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:hint="@string/ecom_card_date_hint"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toStartOf="@+id/ecomCvdCardCvvLayout"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"
            style="@style/EcomCardTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ecomCvdCardDateEditText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="56dp"
                style="@style/EcomCardEditText.Date"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ecomCvdCardCvvLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:hint="@string/ecom_vcd_cvc_hint"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"
            style="@style/EcomCardTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ecomCvdCardCvcEditText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                style="@style/EcomCardEditText.CVC"/>
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.motion.widget.MotionLayout>
</merge>
