<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/ecom_card_view_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ecom_24dp"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp">
    <com.google.android.material.textfield.TextInputEditText
        android:textSize="13sp"
        android:textColor="@android:color/black"
        android:textColorHint="#888888"
        android:gravity="start|center_vertical"
        android:id="@+id/ecomEclssSearchInput"
        android:background="@color/ecom_transparent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minHeight="18dp"
        android:hint="@string/ecom_sbp_screen_search_placeholder"
        android:singleLine="true"
        android:layout_weight="1"
        android:textCursorDrawable="@null"
        style="@style/EcomMediumTextStyle"/>
    <ImageView
        android:id="@+id/ecomEclssSearchIcon"
        android:layout_width="@dimen/ecom_24dp"
        android:layout_height="@dimen/ecom_24dp"
        android:layout_marginStart="@dimen/ecom_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ecom_ic_sbp_search"/>
</LinearLayout>
