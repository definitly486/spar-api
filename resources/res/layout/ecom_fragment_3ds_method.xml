<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="600dp"
    android:minHeight="600dp"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/ecom_20dp">
    <WebView
        android:id="@+id/ecomInvisibleWvContent"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <modern.payments.ecomAndroid.presentation.view.EcomDotsLoaderView
        android:id="@+id/ecomInvisibleWvProgress"
        android:visibility="visible"
        android:layout_width="@dimen/ecom_36dp"
        android:layout_height="@dimen/ecom_36dp"
        app:layout_constraintBottom_toTopOf="@+id/ecomInvisibleWvLoadingText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_default="wrap"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ecomInvisibleWvLoadingText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_16dp"
        android:text="@string/ecom_wait_a_second"
        android:layout_marginHorizontal="@dimen/ecom_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecomInvisibleWvProgress"
        style="@style/EcomLoadingTextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
