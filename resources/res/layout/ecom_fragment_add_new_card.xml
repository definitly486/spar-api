<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionName="payTransition">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ecomEfancRoot"
        android:paddingTop="@dimen/ecom_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ecom_16dp"
        android:paddingHorizontal="@dimen/ecom_16dp">
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/ecomEfancTvClientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_16dp"
            android:layout_marginHorizontal="@dimen/ecom_16dp"
            app:layout_constraintEnd_toStartOf="@+id/ecomEfpmMlcvLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/EcomBottomSheet.TranslucentTextStyle"/>
        <TextView
            android:id="@+id/ecomEfancTvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_4dp"
            android:layout_marginHorizontal="@dimen/ecom_16dp"
            app:layout_constraintBottom_toTopOf="@+id/ecomEfancCvCardSelectionButton"
            app:layout_constraintEnd_toStartOf="@+id/ecomEfpmMlcvLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecomEfancTvClientName"
            style="@style/EcomAmountTextStyle"/>
        <modern.payments.ecomAndroid.presentation.view.MerchantLogoCompositeView
            android:id="@+id/ecomEfpmMlcvLogo"
            android:layout_width="@dimen/ecom_merch_logo_size"
            android:layout_height="@dimen/ecom_merch_logo_size"
            android:layout_marginEnd="@dimen/ecom_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecomEfancTvClientName"/>
        <modern.payments.ecomAndroid.presentation.view.EcomCardDataView
            android:id="@+id/ecomEfancCvCardSelectionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_56dp"
            android:layout_marginBottom="@dimen/ecom_8dp"
            app:layout_constraintBottom_toTopOf="@+id/ecomEfancEbvPay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecomEfancTvAmount"
            style="@style/EcomCard.Style"/>
        <TextView
            android:textColor="@color/ecom_red_color"
            android:id="@+id/ecomEfancCardErrorMessageTextView"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="4dp"
            app:layout_constraintBottom_toTopOf="@+id/ecomEfancEbvPay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecomEfancCvCardSelectionButton"/>
        <modern.payments.ecomAndroid.presentation.view.EcomButtonView
            android:id="@+id/ecomEfancEbvPay"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ecom_20dp"
            android:layout_marginBottom="@dimen/ecom_8dp"
            android:text="@string/ecom_next"
            app:flow_verticalBias="1"
            app:layout_constraintBottom_toTopOf="@+id/ecomEfancEbvCancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecomEfancCardErrorMessageTextView"
            style="@style/EcomGreenButton"/>
        <modern.payments.ecomAndroid.presentation.view.EcomButtonView
            android:id="@+id/ecomEfancEbvCancel"
            android:layout_marginTop="@dimen/ecom_8dp"
            android:text="@string/ecom_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/EcomTransparentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
