<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionName="payTransition">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ecom_efo_root"
        android:paddingTop="@dimen/ecom_24dp"
        android:paddingBottom="@dimen/ecom_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ecom_bottomsheet_order_height"
        android:paddingHorizontal="@dimen/ecom_16dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start|center_vertical"
            android:id="@+id/ecom_efo_tv_client_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_16dp"
            android:layout_marginHorizontal="@dimen/ecom_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/EcomBottomSheet.TranslucentTextStyle"/>
        <TextView
            android:id="@+id/ecomEfancTvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_4dp"
            android:layout_marginHorizontal="@dimen/ecom_16dp"
            app:layout_constraintEnd_toStartOf="@+id/ecom_efo_mlcv_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecom_efo_tv_client_name"
            style="@style/EcomAmountTextStyle"/>
        <modern.payments.ecomAndroid.presentation.view.MerchantLogoCompositeView
            android:id="@+id/ecom_efo_mlcv_logo"
            android:layout_width="@dimen/ecom_merch_logo_size"
            android:layout_height="@dimen/ecom_merch_logo_size"
            android:layout_marginEnd="@dimen/ecom_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecom_efo_tv_client_name"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/ecom_efo_cv_card_selection_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ecom_32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecomEfancTvAmount"
            style="@style/EcomCard.Style">
            <include
                android:id="@+id/ecom_efo_include_selected_card"
                layout="@layout/ecom_include_layout_selected_card"/>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ecom_efo_mb_pay"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ecom_20dp"
            android:text="@string/ecom_pay_text"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/ecom_8dp"
            app:iconTint="@color/ecom_text_color_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecom_efo_cv_card_selection_button"
            style="@style/EcomGreenButton"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ecom_efo_acb_cancel"
            android:layout_marginTop="@dimen/ecom_8dp"
            android:text="@string/ecom_cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecom_efo_mb_pay"
            style="@style/EcomTransparentButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
