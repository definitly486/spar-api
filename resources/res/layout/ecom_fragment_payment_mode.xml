<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ecom_16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ecom_16dp"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/ecom_20dp">
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/ecom_efpm_tv_client_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_16dp"
        android:layout_marginHorizontal="@dimen/ecom_16dp"
        app:layout_constraintEnd_toStartOf="@+id/ecomEfpmMlcvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/EcomBottomSheet.TranslucentTextStyle"/>
    <TextView
        android:id="@+id/ecom_efpm_tv_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_4dp"
        android:layout_marginHorizontal="@dimen/ecom_16dp"
        app:layout_constraintEnd_toStartOf="@+id/ecomEfpmMlcvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efpm_tv_client_name"
        style="@style/EcomAmountTextStyle"/>
    <modern.payments.ecomAndroid.presentation.view.MerchantLogoCompositeView
        android:id="@+id/ecomEfpmMlcvLogo"
        android:layout_width="@dimen/ecom_merch_logo_size"
        android:layout_height="@dimen/ecom_merch_logo_size"
        android:layout_marginTop="@dimen/ecom_8dp"
        android:layout_marginEnd="@dimen/ecom_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ecom_efpm_tv_client_name"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ecom_efpm_rv_mode_list"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_20dp"
        android:minHeight="@dimen/ecom_56dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/ecom_efpm_mb_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efpm_tv_amount"/>
    <modern.payments.ecomAndroid.presentation.view.EcomButtonView
        android:id="@+id/ecom_efpm_mb_close"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/ecom_8dp"
        android:layout_marginBottom="@dimen/ecom_16dp"
        android:text="@string/ecom_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efpm_rv_mode_list"
        app:layout_constraintVertical_bias="1"
        style="@style/EcomTransparentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
