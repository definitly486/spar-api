<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ecom_efsbp_root"
    android:paddingTop="@dimen/ecom_16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/ecom_bottomsheet_order_height"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/ecom_16dp">
    <ImageView
        android:id="@+id/ecom_efsbp_iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_8dp"
        android:src="@drawable/ecom_ic_logo_sbp"
        android:contentDescription=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/ecom_efsbp_tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_16dp"
        android:text="@string/ecom_sbp_screen_title"
        android:layout_marginHorizontal="@dimen/ecom_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efsbp_iv_logo"
        style="@style/EcomSelectionTitle"/>
    <TextView
        android:id="@+id/ecom_efsbp_tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ecom_sbp_screen_subtitle"
        android:layout_marginHorizontal="@dimen/ecom_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efsbp_tv_title"
        style="@style/EcomBottomSheet.TranslucentTextStyle"/>
    <modern.payments.ecomAndroid.presentation.view.EcomSbpSearchCompositeView
        android:id="@+id/ecom_esscv_sbp_search_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_efsbp_tv_subtitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ecom_efsbp_rv_bank_list"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_esscv_sbp_search_view"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:gravity="start"
        android:id="@+id/ecom_sbp_empty_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ecom_sbp_screen_search_empty"
        android:layout_marginHorizontal="@dimen/ecom_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecom_esscv_sbp_search_view"
        style="@style/EcomMediumTextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
