<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/ecom_16dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/efss_aciv_status_icon"
        android:layout_width="@dimen/ecom_120dp"
        android:layout_height="@dimen/ecom_120dp"
        android:layout_marginTop="@dimen/ecom_66dp"
        app:srcCompat="@drawable/ecom_ic_mark"
        app:tint="@color/ecom_status_success"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/efss_actv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_24dp"
        style="@style/EcomStatusTextHeader"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_gravity="center_horizontal"
        android:id="@+id/efss_actv_merchant_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_8dp"
        style="@style/EcomStatusTextAmount"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/efss_actv_detailed_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ecom_8dp"
        android:text="@string/ecom_efsf_error_description_text"
        style="@style/EcomStatusTextAmount"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/efss_actv_local_session_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spay_16dp"
        style="@style/EcomErrorDescriptionStyle"/>
    <modern.payments.ecomAndroid.presentation.view.EcomButtonView
        android:id="@+id/efss_fdb_mb_to_payment_methods"
        android:layout_marginTop="@dimen/ecom_70dp"
        android:layout_marginBottom="@dimen/ecom_34dp"
        android:text="@string/ecom_close"
        style="@style/EcomGreenButton"/>
</androidx.appcompat.widget.LinearLayoutCompat>
