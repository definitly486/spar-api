<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ecom_bg_card_data_base"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputLayout
            android:enabled="true"
            android:textColorHint="#888888"
            android:id="@+id/ecom_vcd_card_number_layout"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/ecom_vcd_card_number"
            app:boxStrokeColor="#888888"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintTextColor="#888888"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderText="0001 0002 0003 0004">
            <com.google.android.material.textfield.TextInputEditText
                android:enabled="true"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textColorHint="#888888"
                android:id="@+id/ecom_vcd_card_number_edit_text"
                android:background="@null"
                android:paddingTop="2dp"
                android:paddingBottom="0dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="170dp"
                android:minHeight="24dp"
                android:textCursorDrawable="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ecom_vcd_card_icon_image_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ecom_ic_card_preview"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecom_vcd_card_number_layout"
            app:layout_constraintStart_toEndOf="@+id/ecom_vcd_card_number_layout"/>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="#888888"
            android:id="@+id/ecomCvdCardCvvLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/ecom_vcd_cvc_hint"
            app:boxStrokeColor="#888888"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintTextColor="#888888"
            app:layout_constraintBottom_toBottomOf="@+id/ecom_vcd_card_number_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecom_vcd_card_number_layout"
            app:placeholderText="001">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textColorHint="#888888"
                android:id="@+id/ecom_vcd_card_cvc_edit_text"
                android:background="@null"
                android:paddingTop="2dp"
                android:paddingBottom="0dp"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:inputType="numberPassword"
                android:textCursorDrawable="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:letterSpacing="-0.023"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="#888888"
            android:id="@+id/ecom_vcd_card_date_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:hint="MM/ГГ"
            android:layout_marginEnd="8dp"
            app:boxStrokeColor="#888888"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintTextColor="#888888"
            app:layout_constraintBottom_toBottomOf="@+id/ecom_vcd_card_number_layout"
            app:layout_constraintEnd_toStartOf="@+id/ecomCvdCardCvvLayout"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/ecom_vcd_card_icon_image_view"
            app:layout_constraintTop_toTopOf="@+id/ecom_vcd_card_number_layout"
            app:placeholderText="01/01">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:textColorHint="#888888"
                android:id="@+id/ecom_vcd_card_date_edit_text"
                android:background="@null"
                android:paddingTop="2dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="62dp"
                android:minHeight="24dp"
                android:inputType="date"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:letterSpacing="-0.023"/>
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="#fb233d"
        android:id="@+id/ecom_vcd_card_errorm_message_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Введите номер карты"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
