<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ecom_elni_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="600dp"
    android:transitionName="payTransition"
    android:paddingHorizontal="@dimen/ecom_16dp">
    <ImageView
        android:id="@+id/ecomLeIvErrorIconBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ecom_24dp"
        android:src="@drawable/ecom_ic_circle"
        android:contentDescription="@string/ecom_empty"
        app:layout_constraintBottom_toTopOf="@+id/ecomElniActvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ecomLeIvErrorIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ecom_ic_error"
        android:contentDescription="@string/ecom_empty"
        app:layout_constraintBottom_toBottomOf="@+id/ecomLeIvErrorIconBg"
        app:layout_constraintEnd_toEndOf="@+id/ecomLeIvErrorIconBg"
        app:layout_constraintStart_toStartOf="@+id/ecomLeIvErrorIconBg"
        app:layout_constraintTop_toTopOf="@+id/ecomLeIvErrorIconBg"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ecomElniActvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ecom_no_internet_title_text"
        android:layout_marginHorizontal="@dimen/ecom_24dp"
        app:layout_constraintBottom_toTopOf="@+id/ecomElniActvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/EcomErrorTextStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ecomElniActvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ecom_no_internet_error_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ecomElniActvTitle"
        style="@style/EcomErrorDescriptionStyle"/>
    <modern.payments.ecomAndroid.presentation.view.EcomButtonView
        android:id="@+id/ecomElniEbvTryAgainButton"
        android:layout_marginBottom="8dp"
        android:text="@string/ecom_try_again_text"
        app:layout_constraintBottom_toTopOf="@+id/ecomElniEbvToPaymentMethodsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/EcomGreyButton"/>
    <modern.payments.ecomAndroid.presentation.view.EcomButtonView
        android:id="@+id/ecomElniEbvToPaymentMethodsButton"
        android:layout_marginBottom="@dimen/ecom_16dp"
        android:text="@string/ecom_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/EcomTransparentButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
