<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ecom_76dp"
    style="@style/EcomPayModeSelect.Style">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ecomEripmContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/ecom_20dp"
        android:paddingEnd="@dimen/ecom_20dp">
        <ImageView
            android:id="@+id/ecomEripmAcivModeIcon"
            android:layout_width="@dimen/ecom_36dp"
            android:layout_height="@dimen/ecom_36dp"
            android:contentDescription="@string/ecom_empty"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ecom_ic_spay"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/ecomEripmActvModeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="SberPay"
            android:layout_marginStart="@dimen/ecom_8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_weight="0.18"
            app:layout_constraintStart_toEndOf="@+id/ecomEripmAcivModeIcon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/EcomSelectionTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/ecomEripmActvModeDescription"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/ecom_eripm_spay_description"
            android:maxLines="2"
            android:layout_marginStart="@dimen/ecom_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_weight="0.6"
            app:layout_constraintStart_toEndOf="@+id/ecomEripmActvModeName"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/EcomSelectionDescription.SPay"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
