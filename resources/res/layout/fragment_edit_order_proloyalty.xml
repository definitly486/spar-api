<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons2"
                android:gravity="center_vertical"
                android:id="@+id/tvCountdownMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/proloyalty_specific_order_countdown_message"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toTopOf="@+id/glTop"
                style="@style/Regular.Heading6"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvCountdownMessage"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderInfoOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/proloyalty_specific_order_info"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvOrderId"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderReceiver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/proloyalty_specific_order_receiver"
                app:layout_constraintEnd_toStartOf="@+id/tvReceiverEdit"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderInfoOrder"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvReceiverEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proloyalty_action_edit"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvHeaderReceiver"
                app:layout_constraintTop_toTopOf="@+id/tvHeaderReceiver"
                style="@style/EditOrderEditTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvReceiver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderReceiver"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvReceiver"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvPhone"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderDeliveryMethod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderDeliveryMethod"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/proloyalty_specific_order_date_and_time"
                app:layout_constraintEnd_toStartOf="@+id/tvIntervalEdit"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvAddress"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvIntervalEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proloyalty_action_edit"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvHeaderInterval"
                app:layout_constraintTop_toTopOf="@+id/tvHeaderInterval"
                style="@style/EditOrderEditTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderInterval"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/proloyalty_title_order_status"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvInterval"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderStatus"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderPayment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/proloyalty_specific_order_payment_type"
                app:layout_constraintEnd_toStartOf="@+id/tvPaymentEdit"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvStatus"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPaymentEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proloyalty_action_edit"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvHeaderPayment"
                app:layout_constraintTop_toTopOf="@+id/tvHeaderPayment"
                style="@style/EditOrderEditTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvPayment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderPayment"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderProducts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/proloyalty_specific_order_list"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvPayment"
                style="@style/EditOrderHeaderTitleStyle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderProducts"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvAddFromCatalog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/proloyalty_action_add_product"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvProducts"
                style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvHeaderOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/proloyalty_title_your_order"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvAddFromCatalog"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ilPromocode"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginTop="16dp"
                android:hint="@string/proloyalty_promo_code"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderOrder">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPromocode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:lines="1"
                    android:maxLength="30"
                    android:inputType="text"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvApplyPromocode"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:text="@string/proloyalty_apply"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/ilPromocode"
                app:layout_constraintEnd_toEndOf="@+id/ilPromocode"
                app:layout_constraintTop_toTopOf="@+id/ilPromocode"
                style="@style/Regular.Heading7"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:gravity="center_horizontal"
                android:id="@+id/tvPromocodeStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/ilPromocode"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cvTotalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvPromocodeStatus"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvParamTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/proloyalty_total_payment"
                app:layout_constraintEnd_toStartOf="@+id/tvValueTotalPrice"
                app:layout_constraintHorizontal_weight="14"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/cvTotalInfo"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="end"
                android:id="@+id/tvValueTotalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintHorizontal_weight="6"
                app:layout_constraintStart_toEndOf="@+id/tvParamTotalPrice"
                app:layout_constraintTop_toTopOf="@+id/tvParamTotalPrice"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/vDividerTotalPrice"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvParamTotalPrice"
                style="@style/Divider"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvHeaderComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/proloyalty_title_comment_order"
                app:layout_constraintEnd_toStartOf="@+id/tvCommentEdit"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/vDividerTotalPrice"
                style="@style/EditOrderHeaderTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCommentEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proloyalty_action_edit"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toEndOf="@+id/tvHeaderComment"
                app:layout_constraintTop_toTopOf="@+id/tvHeaderComment"
                style="@style/EditOrderEditTitleStyle"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvHeaderComment"
                style="@style/Regular.Heading7"/>
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/vDividerComment"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/tvComment"
                style="@style/Divider"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/proloyalty_action_save_and_exit"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/vDividerComment"
                style="@style/Button.Primary56.ButtonLargeBold16"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="?attr/colorSecondary"
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/proloyalty_action_cancel_edit_and_exit"
                app:layout_constraintBottom_toBottomOf="@+id/glBottom"
                app:layout_constraintEnd_toEndOf="@+id/glEnd"
                app:layout_constraintStart_toStartOf="@+id/glStart"
                app:layout_constraintTop_toBottomOf="@+id/btnSave"
                app:strokeColor="?attr/colorSecondary"
                app:strokeWidth="1dp"
                style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/glTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="16dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/glBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="24dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_begin="16dp"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/glEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_end="16dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
