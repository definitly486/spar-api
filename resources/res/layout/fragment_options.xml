<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textview.MaterialTextView
                android:textSize="14sp"
                android:textColor="?attr/colorTextIcons2"
                android:id="@+id/tvNotificationHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/notifications"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ru.myspar.legacy.presentation.view.SwitchableTextView
                android:id="@+id/stvPushNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNotificationHeader"
                app:title="@string/get_push_notifications"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvPushNotifications"
                style="@style/Divider"/>
            <ru.myspar.legacy.presentation.view.SwitchableTextView
                android:id="@+id/stvEmailNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvPushNotifications"
                app:title="@string/get_email_notifications"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvEmailNotifications"
                style="@style/Divider"/>
            <ru.myspar.legacy.presentation.view.SwitchableTextView
                android:id="@+id/stvSmsNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvEmailNotifications"
                app:title="@string/get_sms_notifications"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvSmsNotifications"
                style="@style/Divider"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="14sp"
                android:textColor="?attr/colorTextIcons2"
                android:id="@+id/tvOptionsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/parameters"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvSmsNotifications"/>
            <ru.myspar.legacy.presentation.view.SwitchableTextView
                android:id="@+id/stvAutobrightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOptionsHeader"
                app:title="@string/auto_brightness"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvAutobrightness"
                style="@style/Divider"/>
            <ru.myspar.legacy.presentation.view.SwitchableTextView
                android:id="@+id/stvShowQr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvAutobrightness"
                app:title="@string/show_spar_card"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvShowQr"
                style="@style/Divider"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="14sp"
                android:textColor="?attr/colorTextIcons2"
                android:id="@+id/tvSubscriptionHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/auto_renewal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stvShowQr"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserSubscriptionSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSubscriptionHeader"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="14sp"
                android:textColor="?attr/colorTextIcons2"
                android:id="@+id/tvAppearanceHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/appearance_title"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvUserSubscriptionSettings"/>
            <com.google.android.material.textview.MaterialTextView
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvDarkThemeHeader"
                android:padding="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvAppearanceHeader"
                style="@style/Emphasis.Heading6"/>
            <View
                android:id="@+id/vDarkThemeDivider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDarkThemeHeader"
                style="@style/Divider"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupAppearance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvAppearanceHeader, tvDarkThemeHeader, vDarkThemeDivider"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="17sp"
                android:textColor="?attr/colorSecondary2"
                android:gravity="start|center_vertical"
                android:id="@+id/tvDeleteAccount"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginBottom="@dimen/activity_vertical_margin"
                android:text="@string/delete_account"
                android:drawablePadding="14dp"
                android:paddingStart="16dp"
                app:drawableStartCompat="@drawable/ic_delete_trash_red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vDarkThemeDivider"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
