<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPaymentSuccess"
    android:background="?attr/colorSurface"
    android:padding="16dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvSuccessTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_title_order_formed"
        app:layout_constraintBottom_toTopOf="@+id/tvSuccessSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Emphasis.Heading3"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvSuccessSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/proloyalty_title_start_assembly"
        app:layout_constraintBottom_toTopOf="@+id/btnContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSuccessTitle"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/proloyalty_action_fine"
        android:paddingHorizontal="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSuccessSubtitle"
        app:layout_constraintWidth_default="wrap"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvNotificationOrder"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:elevation="4dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNotificationOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_title_notify_order_status"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            style="@style/Switch"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
