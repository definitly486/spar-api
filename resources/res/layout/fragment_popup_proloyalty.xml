<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/vCurtain"
        android:layout_marginTop="@dimen/content_margin_12"
        android:backgroundTint="?attr/colorTextIcons4"
        style="@style/Curtain"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/content_margin_16">
            <TextView
                android:textAppearance="@style/Emphasis.Heading3"
                android:textColor="?attr/colorTextIcons1"
                android:id="@+id/tvTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_24"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPopupImage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded16dp"/>
            <TextView
                android:textAppearance="@style/Emphasis.Heading3"
                android:textColor="?attr/colorTextStaticWhite1"
                android:id="@+id/tvPromoCode"
                android:background="@drawable/bg_rounded_corners_16dp"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"
                android:includeFontPadding="false"
                android:backgroundTint="?attr/colorPrimary"/>
            <TextView
                android:textAppearance="@style/Emphasis.Heading6"
                android:textColor="?attr/colorTextIcons1"
                android:id="@+id/tvSubTitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_16"/>
            <TextView
                android:textAppearance="@style/Android.Body1"
                android:textColor="?attr/colorTextIcons1"
                android:id="@+id/tvDescriptionMessage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_margin_4"/>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <android.widget.Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_16"/>
</LinearLayout>
