<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnContainerReward"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ScrollView
            android:id="@+id/scrollView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivTitle"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/promo_description"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="220dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/card"
                        android:padding="@dimen/content_margin_16"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/content_margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="2">
                        <ru.myspar.legacy.presentation.view.PromoIcon
                            android:id="@+id/iconPromo"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:elevation="4dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorTextIcons2"
                            android:id="@+id/tvBalanceTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/your_balance"
                            android:fontFamily="@font/sf_pro_display"
                            android:layout_marginStart="@dimen/content_margin_16"
                            app:layout_constraintBottom_toTopOf="@+id/tvBalance"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iconPromo"
                            app:layout_constraintTop_toTopOf="@+id/iconPromo"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/tvNoBalance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/promo_no_balance"
                            android:fontFamily="@font/sf_pro_display"
                            android:layout_marginStart="@dimen/content_margin_16"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iconPromo"
                            app:layout_constraintTop_toTopOf="@+id/iconPromo"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="24sp"
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/tvBalance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cera_round_bold"
                            android:layout_marginStart="@dimen/content_margin_16"
                            app:layout_constraintBottom_toBottomOf="@+id/iconPromo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iconPromo"
                            app:layout_constraintTop_toBottomOf="@+id/tvBalanceTitle"/>
                        <androidx.constraintlayout.widget.Barrier
                            android:id="@+id/barrier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:barrierDirection="bottom"
                            app:constraint_referenced_ids="tvNoBalance,tvBalance"/>
                        <View
                            android:id="@+id/divider"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/barrier"
                            style="@style/Divider"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/tvDescription"
                            android:paddingTop="@dimen/content_margin_16"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_pro_display"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/divider"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorTextIcons2"
                            android:id="@+id/tvDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/content_margin_8"
                            android:fontFamily="@font/sf_pro_display"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvDescription"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ru.myspar.legacy.presentation.screen.promotion.views.PromosView
                        android:id="@+id/promosView"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_margin_36"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card"/>
                    <ru.myspar.legacy.presentation.view.SponsorLayoutView
                        android:id="@+id/sponsorLayoutView"
                        android:background="?attr/colorSurface"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/promosView"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="20sp"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/tvConditionsTitle"
                        android:background="?attr/colorSurface"
                        android:paddingTop="@dimen/content_margin_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/promo_condition"
                        android:fontFamily="@font/cera_round_bold"
                        android:paddingHorizontal="@dimen/content_margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sponsorLayoutView"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/tvFullDescription"
                        android:background="?attr/colorSurface"
                        android:paddingTop="@dimen/content_margin_8"
                        android:paddingBottom="@dimen/content_margin_16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/content_margin_16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvConditionsTitle"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorTextIcons2"
                        android:id="@+id/tvRules"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="24dp"
                        android:layout_marginTop="@dimen/content_margin_8"
                        android:layout_marginBottom="@dimen/content_margin_24"
                        android:fontFamily="@font/sf_pro_display"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvFullDescription"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:padding="@dimen/content_margin_8"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="@dimen/content_margin_8"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorTextStaticWhite1"
            android:contentDescription="@string/back_icon_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16sp"
            android:textColor="?attr/colorTextStaticWhite1"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cera_round_bold"
            android:layout_marginStart="@dimen/content_margin_16"
            android:layout_marginEnd="60dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/btnContainerReward"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="@dimen/content_margin_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_reward"
            android:layout_marginHorizontal="@dimen/content_margin_12"
            android:layout_marginVertical="@dimen/content_margin_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/footerTv"
            style="@style/Button.Primary40.ButtonLargeBold16"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
