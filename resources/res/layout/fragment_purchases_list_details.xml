<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPurchasesListDetails"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.aitsuki.swipe.SwipeMenuRecyclerView
        android:orientation="vertical"
        android:id="@+id/rvProducts"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
    <View
        android:id="@+id/bottomDivider"
        android:background="?attr/colorSpecialSurface6"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintBottom_toTopOf="@+id/productPrice"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvProductsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/content_margin_16"
        android:text="@string/purchases_list_details_products_count"
        app:layout_constraintBottom_toBottomOf="@+id/productPrice"
        app:layout_constraintRight_toLeftOf="@+id/productPrice"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Android.Body1"/>
    <ru.myspar.legacy.presentation.view.ProductPriceView
        android:id="@+id/productPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/content_margin_16"
        android:layout_marginBottom="@dimen/content_margin_8"
        app:darkThemeSupport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:priceCurrencyTextAppearance="@style/Emphasis.Heading3"
        app:priceDecimalTextAppearance="@style/Emphasis.Heading6"
        app:priceTextAppearance="@style/Emphasis.Heading3"
        app:showMeasure="false"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupTotalCounter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bottomDivider,tvProductsCount,productPrice"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvEmptyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/purchases_lists_empty_view_title"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/tvEmptyDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Emphasis.Heading4"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvEmptyDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_8"
        android:text="@string/purchases_list_details_empty_view_subtitle"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/bottomDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEmptyTitle"
        style="@style/Android.Body1"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNavigateToCatalog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:text="@string/action_go_catalog"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEmptyDescription"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupEmptyView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvEmptyTitle,tvEmptyDescription, btnNavigateToCatalog"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
