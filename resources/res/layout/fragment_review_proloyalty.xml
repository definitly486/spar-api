<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/includeReviewHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        layout="@layout/item_review_header_proloyalty"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReviews"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/includeReviewHeader"
        app:layout_goneMarginTop="0dp"/>
    <TextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_horizontal"
        android:id="@+id/tvReviewListStubTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/tvReviewListStubDescription"
        app:layout_constraintTop_toBottomOf="@+id/includeReviewHeader"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Emphasis.Heading4"/>
    <TextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_horizontal"
        android:id="@+id/tvReviewListStubDescription"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarBackground"
        app:layout_constraintTop_toBottomOf="@+id/tvReviewListStubTitle"
        style="@style/Android.Body1"/>
    <View
        android:id="@+id/bottomBarBackground"
        android:background="?attr/colorSpecialSurface1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vDivider"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/vDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/mbtEditReview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Divider"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbtEditReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/proloyalty_reviews_add_new"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/addReviewGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="bottomBarBackground, vDivider, mbtEditReview"/>
    <ImageView
        android:id="@+id/ivStub"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_reviews_empty"
        app:layout_constraintBottom_toTopOf="@+id/tvStubTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="?attr/colorSpecialSurface6"/>
    <TextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_horizontal"
        android:id="@+id/tvStubTitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/tvStubDescription"
        app:layout_constraintTop_toBottomOf="@+id/ivStub"
        style="@style/Emphasis.Heading4"/>
    <TextView
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_horizontal"
        android:id="@+id/tvStubDescription"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/btnStubAction"
        app:layout_constraintTop_toBottomOf="@+id/tvStubTitle"
        style="@style/Android.Body1"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStubAction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStubDescription"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupEmptyReviewsStub"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivStub, tvStubTitle, tvStubDescription, btnStubAction"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
