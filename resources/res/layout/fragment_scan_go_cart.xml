<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnTutorial"
        android:background="@null"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_info"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/scango_cart_title"
        app:layout_constraintBottom_toBottomOf="@+id/btnHome"
        app:layout_constraintEnd_toStartOf="@+id/btnHome"
        app:layout_constraintStart_toEndOf="@+id/btnTutorial"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Emphasis.Heading6"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnHome"
        android:background="@null"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_home"/>
    <View
        android:id="@+id/tvFirstDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/btnHome"
        style="@style/Divider"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTotalPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="@string/total_payment"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvPriceInt"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvPriceInt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Emphasis.Heading4"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvPriceFract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/tvPriceInt"
        app:layout_constraintTop_toTopOf="@+id/tvPriceInt"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rouble"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/tvPriceFract"
        app:layout_constraintTop_toTopOf="@+id/tvPriceFract"
        style="@style/Emphasis.Heading4"/>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:id="@+id/btnCheckout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/scango_checkout"
        android:layout_marginEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvCurrency"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvCurrency"
        style="@style/ScanGoButton"/>
    <androidx.recyclerview.widget.RecyclerView
        android:theme="@style/ScanGoEdgeOverlayTheme"
        android:id="@+id/rvCartContent"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnScan"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstDivider"/>
    <include
        android:id="@+id/includeEmptyMessage"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btnScan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFirstDivider"
        layout="@layout/partial_scan_go_cart_empty"/>
    <ru.myspar.scango.impl.screens.cart.presentation.view.ScanGoReturnDeletedProductView
        android:id="@+id/viewReturnDeletedProduct"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/btnScan"
        app:layout_constraintStart_toStartOf="@+id/btnScan"
        app:layout_constraintTop_toBottomOf="@+id/btnScan"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/button_scan"
        android:layout_marginHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTotalPayment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ScanGoButton"/>
    <ru.myspar.scango.impl.screens.cart.presentation.view.ScanGoTutorialOverlayView
        android:id="@+id/tutorialOverlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/ScanGoTutorialOverlay"/>
</androidx.constraintlayout.widget.ConstraintLayout>
