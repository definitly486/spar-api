<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toBottomOf="@+id/scanWindowView"
        style="@style/ScanBackground"/>
    <ru.myspar.legacy.presentation.view.ScanWindowView
        android:id="@+id/scanWindowView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxHeight="220dp"
        android:minHeight="200dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="20dp"
        app:layout_constraintBottom_toTopOf="@+id/etProductBarcode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrierAppBar"
        app:mode="CODE"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAppBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnToggleFlash, tvScanDescriptionTitle"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etProductBarcode"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="36dp"
        android:hint="@string/title_barcode_search"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/flBottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/BarcodeEditTextStyle"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorError"
        android:ellipsize="end"
        android:id="@+id/tvScanMatrixError"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/scan_go_matrix_scan_title"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="@+id/etProductBarcode"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/etProductBarcode"
        app:layout_constraintTop_toBottomOf="@+id/etProductBarcode"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSearchIcon"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/etProductBarcode"
        app:layout_constraintEnd_toEndOf="@+id/etProductBarcode"
        app:layout_constraintTop_toTopOf="@+id/etProductBarcode"
        app:srcCompat="@drawable/ic_search"
        app:tint="?attr/colorTextStaticWhite1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClearField"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/etProductBarcode"
        app:layout_constraintEnd_toEndOf="@+id/etProductBarcode"
        app:layout_constraintTop_toTopOf="@+id/etProductBarcode"
        app:srcCompat="@drawable/ic_close_clear"
        app:tint="?attr/colorTextStaticWhite1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextStaticWhite1"
        android:gravity="center_vertical"
        android:id="@+id/tvScanDescriptionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/scan_go_matrix_scan_instruction"
        app:layout_constraintEnd_toStartOf="@+id/btnToggleFlash"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Regular.Heading6"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleFlash"
        android:background="@null"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvScanDescriptionTitle"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toEndOf="@+id/tvScanDescriptionTitle"
        app:layout_constraintTop_toTopOf="@+id/tvScanDescriptionTitle"
        app:srcCompat="@drawable/ic_flash_off"/>
    <View
        android:background="@drawable/ic_scan_line"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:backgroundTint="?attr/colorAdditional1"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/flBottomContainer"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/scan_go_matrix_scan_title"
            android:layout_marginHorizontal="62dp"
            style="@style/Emphasis.Heading6"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            app:srcCompat="@drawable/ic_scan_matrix"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/scan_go_matrix_scan_skip_adding"
            android:layout_marginHorizontal="62dp"
            style="@style/ScanGoCancelButton"/>
    </LinearLayout>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
</androidx.constraintlayout.widget.ConstraintLayout>
