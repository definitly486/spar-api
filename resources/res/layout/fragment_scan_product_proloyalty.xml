<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/previewView"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toBottomOf="@+id/scanWindowView"
        style="@style/ScanBackground"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ScanWindowView
        android:id="@+id/scanWindowView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="100dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:mode="CODE"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnBack"
        android:background="@null"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:srcCompat="@drawable/ic_arrow_back"
        app:tint="?attr/colorTextStaticWhite1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnToggleFlash"
        android:background="@null"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toBottomOf="@+id/scanWindowView"
        app:srcCompat="@drawable/ic_flash_off"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="?attr/colorTextStaticWhite1"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/proloyalty_scan_and_go_product_scan_instruction"
        android:fontFamily="@font/sf_pro"
        app:layout_constraintBottom_toTopOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        style="@style/Regular.Heading6"/>
    <View
        android:background="@drawable/ic_scan_line"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
