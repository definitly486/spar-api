<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutMapAndList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        style="@style/TabLayoutForMap">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_shops_map"/>
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_shops_list"/>
    </com.google.android.material.tabs.TabLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvShops"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/content_margin_16"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirm"
        app:layout_constraintTop_toBottomOf="@+id/tabLayoutMapAndList"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:text="@string/confirm"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
    <com.yandex.mapkit.mapview.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        android:layout_marginVertical="@dimen/content_margin_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayoutMapAndList"
        app:movable="true"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvZoomIncrease"
        android:background="@drawable/bg_rounded_top_corners_48dp"
        android:text="@string/shop_addresses_button_increase"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/tvZoomDecrease"
        app:layout_constraintEnd_toEndOf="@+id/tvZoomDecrease"
        app:layout_constraintStart_toStartOf="@+id/tvZoomDecrease"
        style="@style/MapZoomButtonStyle"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvZoomDecrease"
        android:background="@drawable/bg_rounded_bottom_corners_48dp"
        android:layout_marginBottom="28dp"
        android:text="@string/shop_addresses_button_decrease"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/ivNavigation"
        app:layout_constraintEnd_toEndOf="@+id/ivNavigation"
        app:layout_constraintStart_toStartOf="@+id/ivNavigation"
        style="@style/MapZoomButtonStyle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNavigation"
        android:background="@drawable/bg_navigation_marker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_navigation"
        android:layout_marginEnd="16dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/mapView"
        app:layout_constraintEnd_toEndOf="@+id/mapView"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupMapItems"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mapView,tvZoomIncrease,tvZoomDecrease,ivNavigation"/>
</androidx.constraintlayout.widget.ConstraintLayout>
