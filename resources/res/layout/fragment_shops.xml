<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tbGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="40dp"
        android:translationZ="4dp"
        app:checkedButton="@+id/btnOnMap"
        app:layout_constraintEnd_toStartOf="@+id/btnFilters"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnMap"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/shop_addresses_button_on_map"
            style="@style/ToggleGroupButtonStyle"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInList"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/shop_addresses_button_list"
            style="@style/ToggleGroupButtonStyle"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rvShops"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbGroup"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center"
        android:id="@+id/tvEmptyListError"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbGroup"/>
    <ImageButton
        android:id="@+id/btnFilters"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_filter_three_lines"
        android:layout_marginEnd="12dp"
        android:elevation="4dp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        app:tint="@color/filter_button_icon_tint"
        style="@style/FilterButton"/>
    <com.yandex.mapkit.mapview.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tbGroup"
        app:movable="true"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvZoomIncrease"
        android:background="@drawable/bg_rounded_top_corners_48dp"
        android:text="@string/shop_addresses_button_increase"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/tvZoomDecrease"
        app:layout_constraintEnd_toEndOf="@+id/tvZoomDecrease"
        app:layout_constraintStart_toStartOf="@+id/tvZoomDecrease"
        style="@style/MapZoomButtonStyle"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvZoomDecrease"
        android:background="@drawable/bg_rounded_bottom_corners_48dp"
        android:layout_marginBottom="28dp"
        android:text="@string/shop_addresses_button_decrease"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@+id/ivNavigation"
        app:layout_constraintEnd_toEndOf="@+id/ivNavigation"
        app:layout_constraintStart_toStartOf="@+id/ivNavigation"
        style="@style/MapZoomButtonStyle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNavigation"
        android:background="@drawable/bg_navigation_marker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="96dp"
        android:src="@drawable/ic_navigation"
        android:layout_marginEnd="16dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="mapView,tvZoomDecrease,tvZoomIncrease,ivNavigation"/>
</androidx.constraintlayout.widget.ConstraintLayout>
