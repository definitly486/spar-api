<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:nestedScrollingEnabled="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivHeader"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="fitXY"
                    app:layout_constraintDimensionRatio="16:10"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="32sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="32dp"
                android:text="@string/spar_club_map_title"
                android:fontFamily="@font/cera"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/spar_club_description"
                android:fontFamily="@font/sf_pro"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/spar_club_card_description"
                android:fontFamily="@font/sf_pro"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="32sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/spar_club_cart_addition_info"
                android:fontFamily="@font/cera"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"/>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon1"
                    android:src="@drawable/spar_club_icon_1"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_first"
                    android:layout_alignTop="@+id/ivIcon1"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon1"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_captiotn_first_description"
                    android:layout_below="@+id/tvCaption1"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon1"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon2"
                    android:src="@drawable/spar_club_icon_2"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_second"
                    android:layout_alignTop="@+id/ivIcon2"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon2"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_second_description"
                    android:layout_below="@+id/tvCaption2"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon2"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon3"
                    android:src="@drawable/spar_club_icon_3"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_third"
                    android:layout_alignTop="@+id/ivIcon3"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon3"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_third_description"
                    android:layout_below="@+id/tvCaption3"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon3"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon4"
                    android:src="@drawable/spar_club_icon_4"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_fourth"
                    android:layout_alignTop="@+id/ivIcon4"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon4"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_fourth_description"
                    android:layout_below="@+id/tvCaption4"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon4"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon5"
                    android:src="@drawable/spar_club_icon_5"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_forties"
                    android:layout_alignTop="@+id/ivIcon5"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon5"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_forties_description"
                    android:layout_below="@+id/tvCaption5"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon5"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivIcon6"
                    android:src="@drawable/ic_clock_spar_club_icon_6"
                    style="@style/SparClubIconStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="21sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCaption6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_sixty"
                    android:layout_alignTop="@+id/ivIcon6"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon6"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorTextIcons2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spar_club_caption_sixty_description"
                    android:layout_below="@+id/tvCaption6"
                    android:fontFamily="@font/sf_pro"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="32dp"
                    android:layout_toEndOf="@+id/ivIcon6"/>
            </RelativeLayout>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="15sp"
                android:textColor="?attr/colorPrimary"
                android:id="@+id/tvFull"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="64dp"
                android:text="@string/spar_club_addition_info"
                android:fontFamily="@font/sf_pro"
                android:paddingEnd="24dp"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
