<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSpecificOrder"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/orderMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"
        layout="@layout/partial_order_message_proloyalty"/>
    <include
        android:id="@+id/orderTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderMessage"
        layout="@layout/partial_order_timer_proloyalty"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderTimer">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContainer"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:focusableInTouchMode="true"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRateOrder"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/proloyalty_rate_order_button"
                    android:layout_marginStart="@dimen/content_margin_48"
                    android:layout_marginEnd="@dimen/content_margin_48"
                    style="@style/AdditionalActionButtonStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvRatingTitle"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_order_you_rating"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    android:layout_marginVertical="0dp"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/rbRatingApp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:numStars="5"
                    android:stepSize="1"
                    android:isIndicator="true"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/RatingBarStyle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/pickupStatusContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOnMyWay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/proloyalty_on_my_way"
                        android:layout_marginHorizontal="@dimen/content_margin_32"
                        style="@style/Button.Primary56.ButtonLargeBold16"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInPlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/proloyalty_in_place"
                        android:layout_marginHorizontal="@dimen/content_margin_32"
                        style="@style/Button.Primary56.ButtonLargeBold16"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPay"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/proloyalty_action_pay"
                    android:layout_marginStart="@dimen/content_margin_48"
                    android:layout_marginEnd="@dimen/content_margin_48"
                    style="@style/Button.Primary56.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:id="@+id/btnCall"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/proloyalty_specific_order_call_to_market"
                    android:layout_marginStart="@dimen/content_margin_48"
                    android:layout_marginEnd="@dimen/content_margin_48"
                    style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_8"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/proloyalty_specific_order_number"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SpecificOrderHeaderTitleStyle"/>
                    <FrameLayout
                        android:id="@+id/flCopyOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="@+id/tvOrderId"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvOrderId">
                        <include
                            android:id="@+id/ivCopyOrderNumber"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            layout="@layout/view_copy_to_check_mark_proloyalty"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_specific_order_receiver"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvReceiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPartnerType"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPartnerName"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDeliveryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_method_obtain_header"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDeliveryMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_specific_order_delivering"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPostamatCodeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_code_for_opening_postamat"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPostamatCodeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_specific_order_delivering"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ivPostamatQrCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_12"
                    android:scaleType="fitCenter"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"/>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_specific_order_date_and_time"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_title_order_status"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvOrderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_specific_order_payment_type"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderSubtitleStyle"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="20sp"
                    android:textColor="?attr/colorTextIcons1"
                    android:id="@+id/tvNotAvailableList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="@string/proloyalty_specific_order_not_available_list"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Emphasis.Heading5"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReplaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/proloyalty_specific_order_list_replacement_delete_all"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.SecondaryNegative40.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:enabled="false"
                    android:id="@+id/btnSendReplacement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/proloyalty_confirm_replaces"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.Primary40.ButtonLargeBold16"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="20sp"
                    android:id="@+id/tvOrderList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/proloyalty_specific_order_list"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/orderProductsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="20sp"
                    android:id="@+id/tvRemovedOrderList"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/proloyalty_specific_order_list_unavailable"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/SpecificOrderHeaderTitleStyle"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/removedOrderProducts"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llPriceBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cvTotalInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/proloyalty_specific_order_payment_amount"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:paddingEnd="8dp"
                            app:autoSizeMaxTextSize="24sp"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeStepGranularity="2sp"
                            app:autoSizeTextType="uniform"
                            style="@style/Emphasis.Heading5"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="end"
                            android:id="@+id/tvTotalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Emphasis.Heading5"/>
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTipsOrder"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_16"
                    android:text="@string/proloyalty_specific_order_tips_order"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.Primary56.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_16"
                    android:text="@string/proloyalty_specific_order_repeat_order"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.Primary56.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_16"
                    android:text="@string/proloyalty_specific_order_edit_order"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackMyOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_16"
                    android:text="@string/proloyalty_specific_where_is_my_order"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.Primary56.ButtonLargeBold16"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelOrder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_margin_16"
                    android:text="@string/proloyalty_specific_order_cancel_order"
                    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                    style="@style/Button.SecondaryNegative56.ButtonLargeBold16"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
