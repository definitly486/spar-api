<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContainer"
            android:descendantFocusability="beforeDescendants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llDeliveryTypeContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:id="@+id/tvOrderDateHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/specific_purchase_order_date_title"
                        android:layout_marginHorizontal="16dp"
                        style="@style/Emphasis.Heading5"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:id="@+id/tvOrderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        style="@style/Regular.Heading6"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:id="@+id/tvAddressHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/specific_purchase_address_title"
                        android:layout_marginHorizontal="16dp"
                        style="@style/Emphasis.Heading5"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:id="@+id/tvAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        style="@style/Regular.Heading6"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/specific_purchase_products_title"
                        android:layout_marginHorizontal="16dp"
                        style="@style/Emphasis.Heading5"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        style="@style/Divider"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <LinearLayout
                    android:id="@+id/priceContainer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:layout_marginHorizontal="16dp">
                    <com.google.android.material.textview.MaterialTextView
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/specific_purchase_summary_title"
                        android:layout_weight="6"
                        style="@style/Emphasis.Heading5"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="center_vertical"
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:layout_marginStart="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Emphasis.Heading5"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="center_vertical"
                            android:layout_gravity="top"
                            android:id="@+id/tvPriceDecimal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@+id/tvPrice"
                            app:layout_constraintTop_toTopOf="@+id/tvPrice"
                            style="@style/Emphasis.Heading6"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="center_vertical"
                            android:layout_gravity="center"
                            android:id="@+id/tvCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rouble"
                            android:layout_marginStart="2dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPrice"
                            app:layout_constraintStart_toEndOf="@+id/tvPriceDecimal"
                            app:layout_constraintTop_toTopOf="@+id/tvPrice"
                            style="@style/Emphasis.Heading5"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:id="@+id/flRepeatPurchaseContainer"
            android:background="?attr/colorSurface"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="16dp">
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center"
                android:id="@+id/btnRepeatPurchase"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/specific_purchase_retry_order"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                style="@style/Button.Primary56.ButtonLargeBold16"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
