<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvSuccessRetryTitle"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_specific_purchase_success_retry_title"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/tvSuccessRetrySubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Emphasis.Heading3"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/tvSuccessRetrySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/proloyalty_specific_purchase_success_retry_subtitle"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/mbtReturnToCart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSuccessRetryTitle"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/mbtReturnToCart"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/proloyalty_specific_purchase_success_retry_return"
        android:fontFamily="@font/cera_round_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSuccessRetrySubtitle"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Button.Primary56.ButtonLargeBold16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
