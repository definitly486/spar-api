<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/clRoot"
    android:background="?attr/colorSurface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/productScrollContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginBottom="100dp"
            app:layout_constraintBottom_toTopOf="@+id/clControlContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/proloyalty_product_photo_description"
                    app:layout_constraintDimensionRatio="360:240"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded16dp"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
                    app:layout_constraintStart_toStartOf="@+id/guidelineStart"
                    app:layout_constraintTop_toBottomOf="@+id/ivPhoto"
                    style="@style/Emphasis.Heading3"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvPricePerUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@+id/guidelineStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvName"
                    style="@style/Emphasis.Heading3"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center_vertical"
                    android:id="@+id/tvPricePerUnitDecimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toEndOf="@+id/tvPricePerUnit"
                    app:layout_constraintTop_toTopOf="@+id/tvPricePerUnit"
                    style="@style/Emphasis.Heading7"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvPricePerUnitCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/proloyalty_rouble"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvPricePerUnit"
                    app:layout_constraintStart_toEndOf="@+id/tvPricePerUnitDecimal"
                    style="@style/Emphasis.Heading3"/>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvOldPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvPricePerUnitCurrency"
                    app:layout_constraintEnd_toStartOf="@+id/barrierMeasure"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/tvPricePerUnitCurrency"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrierMeasure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="start"
                    app:barrierMargin="-16dp"
                    app:constraint_referenced_ids="tvWeightPerUnit"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textSize="24sp"
                    android:gravity="end"
                    android:id="@+id/tvWeightPerUnit"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cera_round_regular"
                    app:layout_constraintBottom_toBottomOf="@+id/tvPricePerUnitCurrency"
                    app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
                    app:layout_constraintTop_toTopOf="@+id/tvPricePerUnitCurrency"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorTextIcons2"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
                    app:layout_constraintStart_toStartOf="@+id/guidelineStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvPricePerUnit"
                    style="@style/Regular.Heading6"/>
                <ru.myspar.proloyalty.legacy.presentation.view.seasontickets.ProductParamsContainer
                    android:id="@+id/productParamsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/guidelineEnd"
                    app:layout_constraintStart_toStartOf="@+id/guidelineStart"
                    app:layout_constraintTop_toBottomOf="@+id/tvDescription">
                    <ru.myspar.proloyalty.legacy.presentation.view.ProductParameterViewNew
                        android:id="@+id/ppvEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:label="@string/proloyalty_energy"/>
                    <ru.myspar.proloyalty.legacy.presentation.view.ProductParameterViewNew
                        android:id="@+id/ppvProteins"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:label="@string/proloyalty_proteins"/>
                    <ru.myspar.proloyalty.legacy.presentation.view.ProductParameterViewNew
                        android:id="@+id/ppvFats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:label="@string/proloyalty_fats"/>
                    <ru.myspar.proloyalty.legacy.presentation.view.ProductParameterViewNew
                        android:id="@+id/ppvCarbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:label="@string/proloyalty_carbs"/>
                </ru.myspar.proloyalty.legacy.presentation.view.seasontickets.ProductParamsContainer>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="horizontal"
                    android:id="@+id/guidelineTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="24dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="horizontal"
                    android:id="@+id/guidelineBottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintGuide_end="32dp"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guidelineStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="@dimen/activity_horizontal_margin"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guidelineEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintGuide_end="@dimen/activity_horizontal_margin"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/clControlContainer"
            android:background="?attr/colorSpecialSurface1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginStart="16dp"
                android:layout_marginVertical="14dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/tvTotalPriceDecimal"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvTotalPriceDecimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginStart="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/tvTotalPriceCurrency"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/tvTotalPrice"
                app:layout_constraintTop_toTopOf="@+id/tvTotalPrice"
                app:layout_goneMarginBottom="18dp"
                app:layout_goneMarginTop="42dp"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvTotalPriceCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/proloyalty_rouble"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBaseline_toBaselineOf="@+id/tvTotalPrice"
                app:layout_constraintEnd_toStartOf="@+id/barrier"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/tvTotalPriceDecimal"
                style="@style/Emphasis.Heading5"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="counter"/>
            <androidx.constraintlayout.widget.Barrier
                android:orientation="horizontal"
                android:id="@+id/barrierHorizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tvTotalPrice,tvTotalPriceDecimal,tvTotalPriceCurrency,counter"/>
            <ru.myspar.proloyalty.legacy.presentation.view.ProductCounterNew
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="140dp"
                android:layout_marginEnd="16dp"
                app:actionIconSize="@dimen/product_counter_icon_size"
                app:actionTextSize="@dimen/product_counter_text_size"
                app:amountTextSize="@dimen/product_counter_text_size"
                app:customTextColor="@color/counter_text_color"
                app:layout_constraintBottom_toBottomOf="@+id/tvTotalPrice"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTotalPrice"/>
            <ru.myspar.proloyalty.legacy.presentation.view.BuyButtonNew
                android:id="@+id/btnBuy"
                android:padding="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrierHorizontal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/flCurtain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center"
            style="@style/Curtain.Inverse"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
