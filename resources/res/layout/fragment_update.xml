<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/vCurtain"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Curtain"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/vCurtain"
            style="@style/Emphasis.Heading3"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_vertical"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/Regular.Heading6"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/action_update"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage"
            style="@style/Button.Primary56.ButtonLargeBold16"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:gravity="center_vertical"
            android:id="@+id/tvInfo"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_show_card_loyalty_info"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/btnUpdate"
            style="@style/Regular.Heading6"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ivQrCard, tvCard, tvCardCaption"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivQrCard"
            android:padding="4dp"
            android:layout_width="288dp"
            android:layout_height="288dp"
            android:layout_marginTop="24dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:contentDescription="@string/qr_description"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvInfo"
            app:shapeAppearanceOverlay="@style/QrRoundedImageView"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_vertical"
            android:id="@+id/tvCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/ivQrCard"
            app:layout_constraintWidth_default="wrap"
            style="@style/Emphasis.Heading5"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvCardCaption"
            android:paddingBottom="36dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_card_number"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="@+id/glEnd"
            app:layout_constraintStart_toStartOf="@+id/glStart"
            app:layout_constraintTop_toBottomOf="@+id/tvCard"
            app:layout_constraintWidth_default="wrap"
            style="@style/Regular.Heading6"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/glBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="16dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/glEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
