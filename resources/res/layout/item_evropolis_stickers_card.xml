<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
    app:cardCornerRadius="@dimen/corner_large"
    app:cardElevation="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/colorSurface1"
        android:padding="@dimen/activity_horizontal_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/Android.Body2"
            android:textColor="?attr/colorTextIcons3"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="@+id/ivIcon"/>
        <TextView
            android:textSize="22sp"
            android:textColor="?attr/colorTextIcons1"
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivIcon"
            app:layout_constraintEnd_toEndOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/Emphasis.Heading4"/>
        <Space
            android:id="@+id/spaceTicketTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            app:layout_constraintEnd_toEndOf="@+id/tvTicketTitle"
            app:layout_constraintStart_toStartOf="@+id/tvTicketTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"/>
        <View
            android:id="@+id/viewTicketBg"
            android:background="@drawable/bg_ticket"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/spaceTicketBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spaceTicketTop"/>
        <TextView
            android:textAppearance="@style/Emphasis.Heading6"
            android:textColor="?attr/colorTextStaticBlack1"
            android:id="@+id/tvTicketTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginHorizontal="28dp"
            app:layout_constraintEnd_toEndOf="@+id/viewTicketBg"
            app:layout_constraintStart_toStartOf="@+id/viewTicketBg"
            app:layout_constraintTop_toTopOf="@+id/viewTicketBg"/>
        <TextView
            android:textAppearance="@style/Emphasis.Heading5"
            android:gravity="center"
            android:id="@+id/tvTicketValue"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/lavTicket"
            app:layout_constraintEnd_toEndOf="@+id/lavTicket"
            app:layout_constraintStart_toStartOf="@+id/lavTicket"
            app:layout_constraintTop_toTopOf="@+id/lavTicket"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lavTicket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="@+id/tvTicketTitle"
            app:layout_constraintStart_toStartOf="@+id/tvTicketTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvTicketTitle"
            app:lottie_cacheComposition="true"
            app:lottie_rawRes="@raw/landing_ticket_scratch_animation"/>
        <Space
            android:id="@+id/spaceTicketBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tvTicketTitle"
            app:layout_constraintStart_toStartOf="@+id/tvTicketTitle"
            app:layout_constraintTop_toBottomOf="@+id/lavTicket"/>
        <Button
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewTicketBg"
            style="@style/Button.Primary40.ButtonLargeBold16"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupTicket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="viewTicketBg,tvTicketValue,spaceTicketTop,lavTicket,spaceTicketBottom,tvTicketTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
