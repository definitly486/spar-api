<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:ellipsize="end"
        android:id="@+id/tvDateTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Android.Caption1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/flCopyPromoCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDateTime"
        app:layout_goneMarginStart="16dp"
        style="@style/Emphasis.Heading5"/>
    <FrameLayout
        android:id="@+id/flCopyPromoCode"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="@+id/tvBody"
        app:layout_constraintTop_toTopOf="@+id/tvTitle">
        <include
            android:id="@+id/ivCopyPromoCode"
            android:layout_width="20dp"
            android:layout_height="20dp"
            layout="@layout/view_copy_to_check_mark"/>
    </FrameLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:ellipsize="end"
        android:id="@+id/tvBody"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/Android.Body1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
