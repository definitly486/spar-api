<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvProductVariant"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:backgroundTint="?attr/colorPrimary1"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <TextView
        android:textColor="?attr/colorTextStaticWhite1"
        android:layout_gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        style="@style/Android.Body2"/>
</androidx.cardview.widget.CardView>
