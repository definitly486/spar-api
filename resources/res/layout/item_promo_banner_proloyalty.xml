<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/banner_promo_width"
    android:layout_height="@dimen/banner_promo_height"
    android:elevation="0dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBanner"
        android:background="?attr/colorTextStaticWhite1"
        android:layout_width="@dimen/banner_promo_width"
        android:layout_height="@dimen/banner_promo_height"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/proloyalty_banner_description"/>
    <androidx.compose.ui.platform.ComposeView
        android:layout_gravity="end|bottom"
        android:id="@+id/cvAdPlate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</com.google.android.material.card.MaterialCardView>
