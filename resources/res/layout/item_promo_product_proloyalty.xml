<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="100dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivProductPhoto"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/proloyalty_product_photo_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded8dp"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14sp"
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvProductTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Android.Body2"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ProductPriceView
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_4"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvProductTitle"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvProductPrice"
        style="@style/Android.Caption1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvCurrencyOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_rouble"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvOldPrice"
        app:layout_constraintStart_toEndOf="@+id/tvOldPrice"
        app:layout_constraintTop_toTopOf="@+id/tvOldPrice"
        style="@style/Android.Caption1"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/btnAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/cera"
        android:letterSpacing="-0.01"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivProductPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvCurrencyOldPrice"
        style="@style/Button.Primary40"/>
</androidx.constraintlayout.widget.ConstraintLayout>
