<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPromotionNoStickerHeader"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/promo_action_no_label_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PromoActionNoStickerHeader"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPromotionProduct"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPromotionNoStickerHeader"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded4dp"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPromotionProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPromotionProduct"
        app:layout_constraintTop_toTopOf="@+id/ivPromotionProduct"
        style="@style/PromoActionProductName"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPromotionOldPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvPromotionProductName"
        app:layout_constraintTop_toBottomOf="@+id/tvPromotionProductName"
        style="@style/PromoActionOldPrice"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvPromotionProductRealPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvPromotionOldPrice"
        app:layout_constraintTop_toBottomOf="@+id/tvPromotionOldPrice"
        style="@style/PromoActionRealPrice"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPromotionOldPrice, tvPromotionProductRealPrice"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="?attr/colorTextStaticWhite1"
        android:id="@+id/btnPromotionProductReward"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPromotionProduct"
        app:layout_constraintTop_toBottomOf="@+id/tvPromotionProductRealPrice"
        app:layout_goneMarginTop="22dp"
        style="@style/Button.Primary40.ButtonSmallMedium14"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvPromotionProductRewardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btnPromotionProductReward"
        app:layout_constraintTop_toBottomOf="@+id/btnPromotionProductReward"
        style="@style/Android.Caption1"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPromotionProductRewardText"
        style="@style/Divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
