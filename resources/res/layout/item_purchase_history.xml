<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            app:drawableStartCompat="@drawable/ic_calendar"
            app:layout_constraintEnd_toStartOf="@+id/tvDeliveryType"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Regular.Heading7"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageView"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right_forward"
            android:tint="?attr/colorTextIcons3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:gravity="center_vertical"
            android:id="@+id/tvDeliveryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Emphasis.Heading7"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:drawablePadding="4dp"
            android:layout_marginEnd="4dp"
            app:drawableStartCompat="@drawable/ic_marker_geo"
            app:layout_constraintEnd_toStartOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDate"
            style="@style/Regular.Heading7"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llBonuses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAddress">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons2"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvBonuses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_spar_green"
                style="@style/Regular.Heading7"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons2"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tvAppliedBonuses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_attention_exclamation_mark_16"
                app:drawableTint="?attr/colorPrimary1"
                style="@style/Regular.Heading7"/>
        </LinearLayout>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:gravity="center_vertical"
            android:id="@+id/tvSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/specific_purchase_summary_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llBonuses"
            style="@style/Emphasis.Heading6"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_vertical"
            android:id="@+id/tvSummaryValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvCurrency"
            app:layout_constraintEnd_toStartOf="@+id/tvSummaryDecimal"
            app:layout_constraintTop_toTopOf="@+id/tvCurrency"
            style="@style/Emphasis.Heading6"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_vertical"
            android:id="@+id/tvSummaryDecimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/tvSummaryValue"
            app:layout_constraintTop_toTopOf="@+id/tvSummaryValue"
            style="@style/Emphasis.Heading6"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:gravity="center_vertical"
            android:id="@+id/tvCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rouble"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvSummary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvSummaryDecimal"
            app:layout_constraintTop_toTopOf="@+id/tvSummary"
            style="@style/Emphasis.Heading6"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
