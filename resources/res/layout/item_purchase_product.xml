<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="164dp"
    android:foreground="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/activity_horizontal_margin"
    android:paddingVertical="@dimen/activity_vertical_margin">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_gravity="center"
        android:id="@+id/ivPhoto"
        android:background="?attr/colorTextStaticWhite1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/product_photo_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded8dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrierImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:barrierMargin="8dp"
        app:constraint_referenced_ids="ivPhoto"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toStartOf="@+id/barrierControls"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="8dp"
        style="@style/Android.Body2"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvRatingBar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toTopOf="@+id/tvSum"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toBottomOf="@+id/tvName"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvSum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toBottomOf="@+id/cvRatingBar"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvSumDecimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvSum"
        app:layout_constraintStart_toEndOf="@+id/tvSum"
        app:layout_constraintTop_toTopOf="@+id/tvSum"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvSumCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rouble"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvSum"
        app:layout_constraintStart_toEndOf="@+id/tvSumDecimal"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvPricePerUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toBottomOf="@+id/tvSum"
        style="@style/Android.Caption1"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrierControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ivAddToCart"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFavorite"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_heart_off"
        android:scaleType="center"
        android:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivAddToCart"
        android:background="@drawable/bg_rounded_corners_40dp"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:scaleType="center"
        android:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_basket_14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
