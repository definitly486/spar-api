<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvTotalRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tvReviewCount"
        app:layout_constraintEnd_toEndOf="@+id/barrierRating"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Emphasis.Heading3"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center_vertical"
        android:id="@+id/tvReviewCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/barrierRating"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalRating"
        style="@style/Regular.Heading6"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="ratingBarFive, ratingBarFour, ratingBarThree, ratingBarTwo, ratingBarOne"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/ratingBarFive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:changeEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/ratingBarFour"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:num_stars="5"
        style="@style/ReviewRatingBar.Small"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/ratingBarFour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:changeEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/ratingBarThree"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/ratingBarFive"
        app:num_stars="4"
        style="@style/ReviewRatingBar.Small"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/ratingBarThree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:changeEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/ratingBarTwo"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/ratingBarFour"
        app:num_stars="3"
        style="@style/ReviewRatingBar.Small"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/ratingBarTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:changeEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/ratingBarOne"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/ratingBarThree"
        app:num_stars="2"
        style="@style/ReviewRatingBar.Small"/>
    <ru.myspar.proloyalty.legacy.presentation.view.ratingbar.RatingBarView
        android:id="@+id/ratingBarOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:changeEnabled="false"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintTop_toBottomOf="@+id/ratingBarTwo"
        app:num_stars="1"
        style="@style/ReviewRatingBar.Small"/>
    <ProgressBar
        android:id="@+id/progressBarFive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingBarFive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@+id/ratingBarFive"
        style="@style/ReviewProgressBar"/>
    <ProgressBar
        android:id="@+id/progressBarFour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingBarFour"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@+id/ratingBarFour"
        style="@style/ReviewProgressBar"/>
    <ProgressBar
        android:id="@+id/progressBarThree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingBarThree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@+id/ratingBarThree"
        style="@style/ReviewProgressBar"/>
    <ProgressBar
        android:id="@+id/progressBarTwo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingBarTwo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@+id/ratingBarTwo"
        style="@style/ReviewProgressBar"/>
    <ProgressBar
        android:id="@+id/progressBarOne"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ratingBarOne"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="@+id/ratingBarOne"
        style="@style/ReviewProgressBar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
