<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/scan_and_go_deleted_product_view_background"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ru.myspar.proloyalty.legacy.presentation.view.CircleProgressBar
        android:id="@+id/pbTimer"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/NumberTimerIndicator"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextStaticWhite1"
        android:id="@+id/tvTimeLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbTimer"
        app:layout_constraintEnd_toEndOf="@+id/pbTimer"
        app:layout_constraintStart_toStartOf="@+id/pbTimer"
        app:layout_constraintTop_toTopOf="@+id/pbTimer"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextStaticWhite1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_scan_and_go_product_deleted"
        android:fontFamily="@font/sf_pro"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/pbTimer"
        app:layout_constraintStart_toEndOf="@+id/pbTimer"
        app:layout_constraintTop_toTopOf="@+id/pbTimer"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14sp"
        android:textColor="?attr/colorTextStaticWhite1"
        android:id="@+id/btnReturnProduct"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_scan_and_go_return_product"
        android:fontFamily="@font/sf_pro_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
