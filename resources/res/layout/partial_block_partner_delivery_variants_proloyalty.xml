<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:translationZ="10dp">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center"
        android:id="@+id/tvMainTextRestaurant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_address_restaurant_main_text"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/tvChoosePickupRestaurant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorPrimary"
        android:gravity="center"
        android:id="@+id/tvChoosePickupRestaurant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_pickup_delivery"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMainTextRestaurant"
        style="@style/Regular.Heading6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
