<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/includeContentProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/llAmountContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_scan_go_product_proloyalty"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnDeleteProduct"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/llAmountContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llAmountContainer"
        app:srcCompat="@drawable/ic_delete_product"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/llAmountContainer"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnDeleteProduct"
        app:layout_constraintTop_toBottomOf="@+id/includeContentProduct">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_scan_go_amount_product_in_basket"
            android:fontFamily="@font/sf_pro_semibold"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_scan_go_amount_product_in_basket"
            android:fontFamily="@font/sf_pro_semibold"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="@string/proloyalty_cart"
        android:layout_marginHorizontal="66dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llAmountContainer"
        app:layout_constraintVertical_bias="1"
        style="@style/ScanGoButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
