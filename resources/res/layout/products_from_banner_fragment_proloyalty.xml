<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/viewPriceBlockShadow"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/main.appbar"
            android:background="?attr/colorSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="snap|scroll">
                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textAppearance="@style/Emphasis.Heading7"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:layout_gravity="bottom"
                    android:id="@+id/tvTotalProductsCount"
                    android:background="@drawable/bg_rounded_corners_12dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:backgroundTint="?attr/colorAdditional2"
                    android:layout_marginHorizontal="@dimen/content_margin_16"
                    android:layout_marginVertical="@dimen/content_margin_12"
                    android:paddingHorizontal="@dimen/content_margin_8"
                    android:paddingVertical="@dimen/content_margin_4"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/content_margin_16">
                <TextView
                    android:textColor="?attr/colorTextIcons1"
                    android:ellipsize="end"
                    android:id="@+id/tvProductListTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/content_margin_16"
                    style="@style/Emphasis.Heading4"/>
                <ImageView
                    android:id="@+id/ivToggleAllProducts"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/content_margin_6"
                    android:layout_width="@dimen/content_margin_32"
                    android:layout_height="@dimen/content_margin_32"
                    android:layout_marginEnd="@dimen/content_margin_8"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineCenterVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/viewPriceBlockShadow"
        android:background="@drawable/shadow_top"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBuy"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="@dimen/content_margin_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/ivPriceCurrency"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading3"
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_vertical"
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_8"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/content_margin_16"
        app:layout_constraintBottom_toTopOf="@+id/tvOldPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewPriceBlockShadow"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading6"
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvPriceFractional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/content_margin_2"
        app:layout_constraintStart_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"/>
    <ImageView
        android:id="@+id/ivPriceCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin_4"
        app:layout_constraintStart_toEndOf="@+id/tvPriceFractional"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"
        app:srcCompat="@drawable/ic_rub_one"/>
    <TextView
        android:textAppearance="@style/Android.Caption1"
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvPrice"
        app:layout_constraintTop_toBottomOf="@+id/tvPrice"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/clLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvActionBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
