<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/content_margin_16"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/content_margin_16"/>
    <View
        android:id="@+id/viewCurtain"
        android:layout_marginTop="@dimen/content_margin_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Curtain"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading4"
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvProductSetName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_16"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
        app:layout_constraintStart_toEndOf="@+id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/viewCurtain"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading7"
        android:ellipsize="end"
        android:id="@+id/tvProductsCount"
        android:background="@drawable/bg_rounded_corners_12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:backgroundTint="?attr/colorAdditional2"
        android:paddingHorizontal="@dimen/content_margin_8"
        android:paddingVertical="@dimen/content_margin_4"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/tvProductSetName"
        app:layout_constraintWidth_default="wrap"/>
    <Space
        android:id="@+id/spaceTopPriceBlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_8"
        android:layout_marginTop="@dimen/content_margin_8"
        app:layout_constraintTop_toBottomOf="@+id/tvProductsCount"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading3"
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center_vertical"
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@+id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/spaceTopPriceBlock"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading6"
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvPriceFractional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"/>
    <ImageView
        android:id="@+id/ivPriceCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_margin_4"
        app:layout_constraintStart_toEndOf="@+id/tvPriceFractional"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"
        app:srcCompat="@drawable/ic_rub_one"/>
    <TextView
        android:textAppearance="@style/Android.Caption1"
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/tvPrice"
        app:layout_constraintTop_toBottomOf="@+id/tvPrice"/>
    <Space
        android:id="@+id/spaceBottomPriceBlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_8"
        app:layout_constraintTop_toBottomOf="@+id/tvOldPrice"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierBottomPriceBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="spaceTopPriceBlock, tvPrice, tvPriceFractional, ivPriceCurrency, tvOldPrice, spaceBottomPriceBlock"/>
    <Space
        android:id="@+id/spaceTopCounterBlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_8"
        app:layout_constraintTop_toBottomOf="@+id/barrierBottomPriceBlock"/>
    <ImageView
        android:id="@+id/ivBtnDecrement"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/content_margin_40"
        android:layout_height="@dimen/content_margin_40"
        android:src="@drawable/ic_decrement_circle"
        app:layout_constraintBottom_toTopOf="@+id/barrierBottomCounterBlock"
        app:layout_constraintStart_toEndOf="@+id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/spaceTopCounterBlock"/>
    <ImageView
        android:id="@+id/ivBtnIncrement"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/content_margin_40"
        android:layout_height="@dimen/content_margin_40"
        android:src="@drawable/ic_increment_circle"
        app:layout_constraintBottom_toTopOf="@+id/barrierBottomCounterBlock"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
        app:layout_constraintTop_toBottomOf="@+id/spaceTopCounterBlock"/>
    <TextView
        android:textAppearance="@style/Emphasis.Heading6"
        android:textColor="?attr/colorTextIcons1"
        android:gravity="center"
        android:id="@+id/tvCounterValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/content_margin_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/barrierBottomCounterBlock"
        app:layout_constraintEnd_toStartOf="@+id/ivBtnIncrement"
        app:layout_constraintStart_toEndOf="@+id/ivBtnDecrement"
        app:layout_constraintTop_toBottomOf="@+id/spaceTopCounterBlock"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierBottomCounterBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ivBtnDecrement,tvCounterValue,ivBtnDecrement"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddToBasket"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_margin_8"
        android:text="@string/proloyalty_add_to_cart"
        app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
        app:layout_constraintStart_toEndOf="@+id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@+id/barrierBottomCounterBlock"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/content_margin_16"
        app:layout_constraintTop_toBottomOf="@+id/btnAddToBasket"/>
</androidx.constraintlayout.widget.ConstraintLayout>
