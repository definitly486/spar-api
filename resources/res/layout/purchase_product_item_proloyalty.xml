<?xml version="1.0" encoding="utf-8"?>
<com.aitsuki.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/content_margin_8"
    app:autoClose="true"
    app:designer="@string/classic_designer"
    app:preview="none">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start"
        android:id="@+id/left_menu"
        android:background="?attr/colorSpecialSurface2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/left_text"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="@+id/left_text"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_check_mark_black"
            app:tint="?attr/colorPrimary1"/>
        <TextView
            android:textColor="?attr/colorPrimary1"
            android:id="@+id/left_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/content_margin_16"
            android:text="@string/proloyalty_purchases_list_details_action_buy"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/left_icon"
            style="@style/Common.ButtonSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/right_menu"
        android:background="?attr/colorSecondary2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/right_text"
            app:layout_constraintStart_toStartOf="@+id/right_text"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_delete"/>
        <TextView
            android:textColor="?attr/colorTextStaticWhite1"
            android:id="@+id/right_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/content_margin_16"
            android:text="@string/proloyalty_action_delete"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/right_icon"
            style="@style/Common.ButtonSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ru.myspar.proloyalty.purchases.impl.specific.presentation.view.PurchaseProductView
        android:gravity="center"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.aitsuki.swipe.SwipeLayout>
