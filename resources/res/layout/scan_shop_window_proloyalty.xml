<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ru.myspar.proloyalty.legacy.presentation.view.ScanWindowView
        android:id="@+id/scanWindowView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:mode="QR"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScanBackground"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ScanBackground"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="16sp"
        android:textColor="?attr/colorTextStaticWhite1"
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/proloyalty_scan_and_go_shop_scan_instruction"
        android:fontFamily="@font/sf_pro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintStart_toStartOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        app:layout_constraintTop_toTopOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_height"
        android:layout_height="@dimen/camera_strike_line_width"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
    <View
        android:layout_width="@dimen/camera_strike_line_width"
        android:layout_height="@dimen/camera_strike_line_height"
        app:layout_constraintBottom_toBottomOf="@+id/scanWindowView"
        app:layout_constraintEnd_toEndOf="@+id/scanWindowView"
        style="@style/CameraStrike"/>
</androidx.constraintlayout.widget.ConstraintLayout>
