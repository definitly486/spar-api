<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerTitle"
        android:background="@drawable/bg_rounded_corners_4dp_shimmer"
        android:layout_width="185dp"
        android:layout_height="25dp"
        android:layout_marginTop="@dimen/content_margin_8"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ShimmerFacebook"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/content_margin_16"
        android:layout_marginBottom="@dimen/content_margin_8"
        android:layout_marginHorizontal="@dimen/content_margin_16"
        app:cardCornerRadius="@dimen/content_margin_16"
        app:cardElevation="@dimen/content_margin_2"
        app:contentPadding="@dimen/content_margin_16">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/ShimmerFacebook">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/product_first"
                    android:background="@drawable/bg_rounded_corners_8dp_shimmer"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/product_first_price"
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="55dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="@dimen/content_margin_8"
                    app:layout_constraintStart_toStartOf="@+id/product_first"
                    app:layout_constraintTop_toBottomOf="@+id/product_first"/>
                <View
                    android:id="@+id/product_second"
                    android:background="@drawable/bg_rounded_corners_8dp_shimmer"
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:layout_marginStart="@dimen/content_margin_8"
                    app:layout_constraintStart_toEndOf="@+id/product_first"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/product_second_price"
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="55dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="@dimen/content_margin_8"
                    app:layout_constraintStart_toStartOf="@+id/product_second"
                    app:layout_constraintTop_toBottomOf="@+id/product_second"/>
                <View
                    android:id="@+id/sale_of_percent"
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="46dp"
                    android:layout_height="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/combo_set_price"
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="79dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="@dimen/content_margin_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sale_of_percent"/>
                <View
                    android:id="@+id/combo_set_old_price"
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="47dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/content_margin_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/combo_set_price"/>
                <View
                    android:background="@drawable/bg_rounded_corners_4dp_shimmer"
                    android:layout_width="104dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="@dimen/content_margin_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/product_first_price"/>
                <View
                    android:background="@drawable/shape_circle_shimmer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/content_margin_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
