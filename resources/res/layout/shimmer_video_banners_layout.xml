<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerTitle"
        android:background="@drawable/bg_rounded_corners_4dp_shimmer"
        android:layout_width="150dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ShimmerFacebook"/>
    <include
        android:id="@+id/shimmer1"
        android:layout_width="0dp"
        android:layout_height="186dp"
        android:layout_marginTop="@dimen/activity_horizontal_margin"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        app:layout_constraintDimensionRatio="318:177"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shimmerTitle"
        app:layout_goneMarginTop="0dp"
        layout="@layout/shimmer_item_banner"/>
    <include
        android:id="@+id/shimmer2"
        android:layout_width="0dp"
        android:layout_height="186dp"
        android:layout_marginStart="8dp"
        app:layout_constraintDimensionRatio="318:177"
        app:layout_constraintStart_toEndOf="@+id/shimmer1"
        app:layout_constraintTop_toTopOf="@+id/shimmer1"
        layout="@layout/shimmer_item_banner"/>
</androidx.constraintlayout.widget.ConstraintLayout>
