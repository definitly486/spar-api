<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvBannersCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
        style="@style/Emphasis.Heading5"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBanners"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/activity_horizontal_margin"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/singleBannerRoot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/singleBanner"
            android:background="?attr/colorTextStaticWhite1"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/banner_description"/>
        <androidx.compose.ui.platform.ComposeView
            android:layout_gravity="end|bottom"
            android:id="@+id/cvAdPlate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>
</merge>
