<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/csl_primary"
    android:foregroundTint="?attr/colorSurface"
    style="@style/BuyButtonRounded">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextStaticWhite1"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_to_cart"
        android:textAllCaps="false"
        style="@style/Emphasis.Heading6"/>
    <ProgressBar
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pbLoading"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:alpha="0"
        style="?android:attr/progressBarStyleSmall"/>
</FrameLayout>
