<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/appCompatImageView"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:src="@mipmap/im_loyalty_card_bg"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:contentDescription="@string/card_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextStaticBlack2"
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Emphasis.Heading3"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextStaticBlack2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvBalanceCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/bonuses_caption"
            android:maxLines="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvBalance"
            app:layout_constraintEnd_toStartOf="@+id/ivQr"
            app:layout_constraintStart_toEndOf="@+id/tvBalance"
            style="@style/Emphasis.Heading6"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="14sp"
            android:textColor="?attr/colorTextStaticBlack1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvDescCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/ivQr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBalance"
            style="@style/PromoActionSfProText"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivQr"
            android:background="@drawable/card_loyalty_qr_bg"
            android:padding="6dp"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/qr_default"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:contentDescription="@string/qr_description"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
