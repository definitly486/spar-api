<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorPrimary3"
    app:cardCornerRadius="@dimen/content_margin_16"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/content_margin_8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/gl_products_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.7"/>
        <include
            android:id="@+id/cardProductFirst"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toStartOf="@+id/cardProductSecond"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_combo_set_product_card"/>
        <include
            android:id="@+id/cardProductSecond"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/content_margin_16"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toStartOf="@+id/gl_products_end"
            app:layout_constraintStart_toEndOf="@+id/cardProductFirst"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_combo_set_product_card"/>
        <com.google.android.material.imageview.ShapeableImageView
            android:padding="@dimen/content_margin_2"
            android:layout_width="@dimen/content_margin_40"
            android:layout_height="@dimen/content_margin_40"
            android:src="@drawable/ic_plus_btn_combo_set"
            app:layout_constraintBottom_toBottomOf="@+id/cardProductSecond"
            app:layout_constraintEnd_toEndOf="@+id/gl_products_end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardProductFirst"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceCircle"
            app:strokeColor="?attr/colorPrimary3"
            app:strokeWidth="@dimen/content_margin_4"/>
        <ru.myspar.legacy.presentation.view.ProductPriceView
            android:id="@+id/priceProductFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            app:darkThemeSupport="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardProductFirst"/>
        <ru.myspar.legacy.presentation.view.ProductPriceView
            android:id="@+id/priceProductSecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            app:darkThemeSupport="false"
            app:layout_constraintStart_toStartOf="@+id/cardProductSecond"
            app:layout_constraintTop_toBottomOf="@+id/cardProductSecond"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextStaticWhite1"
            android:gravity="center"
            android:id="@+id/tvDiscountAmount"
            android:background="@drawable/ic_background_discount_badge"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Emphasis.Heading7"/>
        <ru.myspar.legacy.presentation.view.ProductPriceView
            android:id="@+id/priceCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            app:darkThemeSupport="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDiscountAmount"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="@color/black_60"
            android:gravity="center_vertical"
            android:id="@+id/tvOldPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/priceCombo"
            style="@style/Android.Caption1"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16sp"
            android:textColor="?attr/colorPrimary1"
            android:id="@+id/btnShowAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_8"
            android:text="@string/view_all"
            android:textAllCaps="false"
            android:fontFamily="@font/cera_round_bold"
            android:layout_marginStart="@dimen/content_margin_8"
            app:cornerRadius="@dimen/content_margin_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/priceProductFirst"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAddComboSetToBasket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_basket_my_purchases"
            app:backgroundTint="?attr/colorPrimary1"
            app:elevation="0dp"
            app:fabCustomSize="@dimen/content_margin_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
