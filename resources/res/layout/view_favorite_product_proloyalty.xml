<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvImageContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Card.StaticWhite">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/ivPhoto"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="@string/proloyalty_product_photo_description"/>
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrierImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:barrierMargin="8dp"
        app:constraint_referenced_ids="mcvImageContainer"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lines="2"
        app:layout_constraintEnd_toEndOf="@+id/barrierControls"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Android.Body2"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvPricePerUnit"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@+id/barrierControls"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/Android.Caption1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons2"
        android:ellipsize="end"
        android:id="@+id/tvUnavailable"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/proloyalty_cart_unavailable_products_title"
        android:maxLines="2"
        android:fontFamily="@font/cera"
        android:textAlignment="textStart"
        app:layout_constraintBottom_toTopOf="@+id/tvPrice"
        app:layout_constraintEnd_toEndOf="@+id/barrierControls"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        app:layout_constraintVertical_bias="0.8"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvPrice, tvPriceDecimal, tvPriceCurrency"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/barrierImage"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvPriceDecimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/tvPrice"
        app:layout_constraintTop_toTopOf="@+id/tvPrice"
        app:layout_goneMarginBottom="18dp"
        app:layout_goneMarginTop="42dp"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvPriceCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_rouble"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvPrice"
        app:layout_constraintStart_toEndOf="@+id/tvPriceDecimal"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvMeasure"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/proloyalty_favorite_amount_title"
        android:maxLines="1"
        android:layout_marginStart="3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvPrice"
        app:layout_constraintEnd_toEndOf="@+id/barrierControls"
        app:layout_constraintStart_toEndOf="@+id/tvPriceCurrency"
        style="@style/Android.Body2"/>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrierControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:barrierMargin="-8dp"
        app:constraint_referenced_ids="ivFavorite, ivAddToCart, tvCurrentAmount"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFavorite"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_heart_off"
        android:scaleType="center"
        android:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAddToCart"
        android:padding="8dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_basket_primary"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:id="@+id/tvCurrentAmount"
        android:background="@drawable/bg_rounded_corners_16dp"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/cera"
        android:textAlignment="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/CurrentAmountTextStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
