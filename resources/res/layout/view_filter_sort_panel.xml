<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFilters"
        android:background="@drawable/bg_filter"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_filter"
        app:tint="?attr/colorPrimary1"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/llSort"
        android:background="@drawable/bg_filter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons1"
            android:gravity="center_vertical"
            android:id="@+id/tvSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_title_popular"
            android:layout_marginHorizontal="4dp"
            style="@style/Android.Body2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSort"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_arrow_up_down"
            app:tint="?attr/colorPrimary1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivListType"
        android:background="@drawable/bg_filter"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:scaleType="center"
        android:tint="?attr/colorPrimary1"
        android:contentDescription="@string/list_type_description"
        app:srcCompat="@drawable/ic_grid"/>
</merge>
