<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvPricePerUnit"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        app:layout_constraintStart_toEndOf="@+id/mcvImageContainer"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/Android.Caption1"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvPricePerUnitDecimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintStart_toEndOf="@+id/tvPricePerUnit"
        app:layout_constraintTop_toTopOf="@+id/tvPricePerUnit"
        style="@style/Android.Caption2"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvPricePerUnitMeasure"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/tvPricePerUnit"
        app:layout_constraintStart_toEndOf="@+id/tvPricePerUnitDecimal"
        style="@style/Android.Caption1"/>
</LinearLayout>
