<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvRoot"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDecrease"
        android:background="@drawable/ic_circle_32"
        android:padding="11dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_round_minus"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        style="@style/IncreaseImageStyle"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColor="?attr/colorTextIcons1"
        android:textColorHighlight="@color/transparent"
        android:id="@+id/etAmount"
        android:background="@null"
        android:padding="4dp"
        android:saveEnabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/product_counter_amount_default_value"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:maxLength="5"
        android:digits="0123456789.,"
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:textAlignment="center"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/ivDecrease"
        app:layout_constraintEnd_toStartOf="@+id/tvMeasure"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ivDecrease"
        app:layout_constraintTop_toTopOf="@+id/ivDecrease"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons1"
        android:id="@+id/tvMeasure"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/etAmount"
        app:layout_constraintEnd_toStartOf="@+id/ivIncrease"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/etAmount"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvDailyLimit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tvMeasure"
        app:layout_constraintStart_toStartOf="@+id/etAmount"
        app:layout_constraintTop_toBottomOf="@+id/etAmount"
        style="@style/Android.Caption1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIncrease"
        android:background="@drawable/ic_circle_32"
        android:padding="11dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_plus_stroke_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivDecrease"
        style="@style/IncreaseImageStyle"/>
</merge>
