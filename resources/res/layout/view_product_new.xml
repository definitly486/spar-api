<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPhoto"
        android:background="?attr/colorTextStaticWhite1"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/goods_photo_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceRounded8dp"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/ivPhoto"
        app:layout_constraintStart_toStartOf="@+id/ivPhoto"
        app:layout_constraintTop_toTopOf="@+id/ivPhoto"/>
    <TextView
        android:textColor="?attr/colorAdditional4"
        android:gravity="center"
        android:id="@+id/tvDiscountAmount"
        android:background="@drawable/bg_rounded_top_left_bottom_right_corner_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/colorTextStaticWhite2"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivPhoto"
        app:layout_constraintEnd_toEndOf="@+id/ivPhoto"
        style="@style/Emphasis.Heading6"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnAddToPurchaseLists"
        android:background="@drawable/bg_btn_add_to_purchase_list_product_card"
        android:padding="@dimen/content_margin_4"
        android:visibility="gone"
        android:duplicateParentState="false"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:cropToPadding="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivPhoto"
        app:layout_constraintStart_toStartOf="@+id/ivPhoto"
        app:srcCompat="@drawable/ic_echeck_purchase_list"
        app:tint="?attr/colorPrimary1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivRatingIcon"
        android:padding="2dp"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/ic_ratingbar_fill"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivRatingIcon"
        app:layout_constraintStart_toEndOf="@+id/ivRatingIcon"
        app:layout_constraintTop_toTopOf="@+id/ivRatingIcon"/>
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/delimiter"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvRating"
        app:layout_constraintStart_toEndOf="@+id/tvRating"
        app:layout_constraintTop_toTopOf="@+id/tvRating"
        style="@style/TextDelimiter"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvReviewsCount"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvRating"
        app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
        app:layout_constraintStart_toEndOf="@+id/delimiter"
        app:layout_constraintTop_toTopOf="@+id/tvRating"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFavorite"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_heart_off"
        android:scaleType="center"
        android:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_weight="1"
        android:lineSpacingExtra="4sp"
        android:textAlignment="textStart"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/ivRatingIcon"
        app:layout_goneMarginTop="32dp"
        style="@style/Android.Body2"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons2"
        android:gravity="center_vertical"
        android:id="@+id/tvWineCountryAndRegion"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        style="@style/Regular.Heading7"/>
    <ru.myspar.legacy.presentation.view.PricePerUnitView
        android:id="@+id/pricePerUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvWineCountryAndRegion"/>
    <ru.myspar.legacy.presentation.view.MeasureTypeToggle
        android:id="@+id/mttMeasure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/pricePerUnit"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvOldPrice"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/mttMeasure"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalPriceDecimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toEndOf="@+id/tvTotalPrice"
        app:layout_constraintTop_toTopOf="@+id/tvTotalPrice"
        style="@style/Emphasis.Heading6"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvTotalPriceCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rouble"
        android:layout_marginStart="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvTotalPrice"
        app:layout_constraintStart_toEndOf="@+id/tvTotalPriceDecimal"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textSize="12sp"
        android:textColor="?attr/colorTextIcons3"
        android:id="@+id/tvOldPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalPrice"
        style="@style/Android.Caption1"/>
    <ru.myspar.legacy.presentation.view.ProductCounterNew
        android:id="@+id/counter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:actionIconSize="@dimen/product_counter_icon_size"
        app:actionTextSize="@dimen/product_counter_text_size"
        app:amountTextSize="@dimen/product_counter_text_size"
        app:customTextColor="@color/counter_text_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/tvOldPrice"/>
    <ru.myspar.legacy.presentation.view.BuyButtonNew
        android:id="@+id/btnBuy"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/counter"/>
    <com.google.android.material.button.MaterialButton
        android:enabled="false"
        android:gravity="center"
        android:id="@+id/tvProductNotAvailable"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="@string/title_buy_shop"
        android:maxLines="1"
        android:layout_marginStart="8dp"
        android:stateListAnimator="@null"
        android:paddingVertical="0dp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeTextType="uniform"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhoto"
        app:layout_constraintTop_toBottomOf="@+id/counter"
        style="@style/RoundedButton.Disabled"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ratingGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tvRating, ivRatingIcon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/reviewsGroup"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tvReviewsCount, delimiter"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupPrice"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tvTotalPrice, tvTotalPriceDecimal,tvTotalPriceCurrency"/>
</merge>
