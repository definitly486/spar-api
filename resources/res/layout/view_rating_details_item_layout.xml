<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="12dp"
                style="@style/Emphasis.Heading6"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons4"
                android:gravity="center_vertical"
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginHorizontal="12dp"
                style="@style/Regular.Heading7"/>
            <ru.myspar.legacy.presentation.view.ratingbar.RatingBarView
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                app:changeEnabled="false"
                style="@style/ReviewRatingBar.Medium"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorTextIcons2"
                android:ellipsize="end"
                android:gravity="top"
                android:id="@+id/tvComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="12dp"
                style="@style/Regular.Heading6"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_down"
            android:rotation="180"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvAnswerTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAnswerTitle"
            app:tint="@color/csl_primary"/>
        <TextView
            android:textColor="?attr/colorTextIcons4"
            android:gravity="end"
            android:id="@+id/tvAnswerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/ivArrow"
            app:layout_constraintTop_toBottomOf="@+id/llReview"
            style="@style/Regular.Heading7"/>
        <TextView
            android:textColor="?attr/colorTextIcons2"
            android:gravity="end"
            android:id="@+id/tvAnswer"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tvAnswerTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAnswerTitle"
            style="@style/Regular.Heading6"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/llAnswerBlock"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ivArrow, tvAnswerTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
