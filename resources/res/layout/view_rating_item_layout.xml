<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_12"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/content_margin_12"
            style="@style/Emphasis.Heading6"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons4"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/content_margin_12"
            style="@style/Android.Body2"/>
        <ru.myspar.legacy.presentation.view.ratingbar.RatingBarView
            android:id="@+id/ratingBar"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_margin_4"
            android:layout_marginHorizontal="@dimen/content_margin_8"
            app:changeEnabled="false"
            app:scrollable="false"
            style="@style/ReviewRatingBar.Medium"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:ellipsize="end"
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="@dimen/content_margin_12"
            android:maxLines="3"
            android:minLines="3"
            android:layout_marginHorizontal="@dimen/content_margin_12"
            style="@style/Android.Body2"/>
    </LinearLayout>
</merge>
