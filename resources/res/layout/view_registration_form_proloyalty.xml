<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/glBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/proloyalty_last_name_and_name"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toTopOf="@+id/glTop"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:inputType="textCapSentences"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilPhoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/proloyalty_phone_number"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/ilName"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:inputType="phone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/proloyalty_email"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/ilPhoneNumber"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilAdditionalField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/proloyalty_city_of_residence"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/ilEmail"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdditionalField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:inputType="text"
            android:imeOptions="actionDone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvOrderType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/proloyalty_order_type"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/ilAdditionalField"
        style="@style/Emphasis.Heading5"/>
    <RadioGroup
        android:id="@+id/rgOrderType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvOrderType">
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rbInStore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_in_store"
            style="@style/RadioButtonStyle"/>
        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rbOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proloyalty_online"
            style="@style/RadioButtonStyle"/>
    </RadioGroup>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupOrderType"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvOrderType, rgOrderType"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilOrderNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/proloyalty_order_number"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/rgOrderType"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOrderNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="1"
            android:inputType="text"
            android:imeOptions="actionDone"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupOrderNumber"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ilOrderNumber"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/proloyalty_check"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/rgOrderType"
        style="@style/Emphasis.Heading5"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvAttachCheck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proloyalty_attach_check"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvCheck"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAttachCheck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/proloyalty_choose_a_file"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvAttachCheck"
        style="@style/Button.SecondaryNegative40.ButtonLargeBold16"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ilDateReceipt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/proloyalty_receipt_date_field"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/barrierDateReceipt"
        style="@style/RegistrationFormTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="?attr/colorTextIcons1"
            android:textColorHint="?attr/colorTextIcons2"
            android:id="@+id/etDateReceipt"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lines="1"
            android:singleLine="true"
            style="@style/Android.Body1"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDateClear"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_clear_text"
        android:tint="?attr/colorTextIcons1"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/ilDateReceipt"
        app:layout_constraintEnd_toEndOf="@+id/ilDateReceipt"
        app:layout_constraintTop_toTopOf="@+id/ilDateReceipt"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupAttachCheck"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvCheck, tvAttachCheck, btnAttachCheck "/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAttach"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="36dp"
        android:src="@mipmap/baseline_attach_file_black_48"
        android:tint="?attr/colorTextIcons1"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/rgOrderType"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="center_vertical"
        android:id="@+id/tvFilename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/ivDelete"
        app:layout_constraintStart_toEndOf="@+id/ivAttach"
        app:layout_constraintTop_toTopOf="@+id/ivAttach"
        style="@style/Regular.Heading6"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDelete"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@mipmap/icon_close"
        android:tint="?attr/colorTextIcons1"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintTop_toTopOf="@+id/ivAttach"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupFile"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ivAttach, tvFilename, ivDelete"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:barrierMargin="8dp"
        app:constraint_referenced_ids="ivAttach, tvFilename, ivDelete"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierDateReceipt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnAttachCheck ,ivAttach, tvFilename, ivDelete , ilDateReceipt"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="ilOrderNumber, btnAttachCheck, barrierDateReceipt , ilDateReceipt"/>
    <com.google.android.material.textview.MaterialTextView
        android:textColor="?attr/colorTextIcons3"
        android:gravity="center_vertical"
        android:id="@+id/tvTermsOfPublicOffer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/barrier"
        style="@style/Regular.Heading6"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/proloyalty_send"
        app:layout_constraintBottom_toBottomOf="@+id/glBottom"
        app:layout_constraintEnd_toEndOf="@+id/glEnd"
        app:layout_constraintStart_toStartOf="@+id/glStart"
        app:layout_constraintTop_toBottomOf="@+id/tvTermsOfPublicOffer"
        style="@style/Button.Primary40.ButtonLargeBold16"/>
</merge>
