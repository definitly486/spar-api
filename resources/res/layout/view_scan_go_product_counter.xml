<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnMinusQuantity"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_delete_product"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnPlusQuantity"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_plus_product"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlusQuantity"
        app:layout_constraintEnd_toStartOf="@+id/btnPlusQuantity"
        app:layout_constraintStart_toEndOf="@+id/btnMinusQuantity"
        app:layout_constraintTop_toTopOf="@+id/btnPlusQuantity">
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorTextIcons2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_go_amount_product_in_basket"
            android:fontFamily="@font/sf_pro_semibold"/>
        <com.google.android.material.textview.MaterialTextView
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_go_amount_product_in_basket"
            android:fontFamily="@font/sf_pro_semibold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
