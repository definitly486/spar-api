<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcvRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="4dp"
        app:cardCornerRadius="@dimen/subscription_card_radius"
        app:cardElevation="2dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupSparPrime"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="ivSparPrimeImage, ivSparPrimeHeader, tvSparPrimeBody"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupCoffee"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvHeader, tvBody"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSparPrimeHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_logo_spar_prime"
                android:adjustViewBounds="true"
                android:layout_marginHorizontal="16dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/ivTicketImage"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="@color/spar_color_prime_base_color"
                android:gravity="center_vertical"
                android:id="@+id/tvSparPrimeBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginHorizontal="16dp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/ivTicketImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivSparPrimeHeader"
                style="@style/Android.Body2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSparPrimeImage"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:maxLines="2"
                android:layout_marginHorizontal="16dp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@+id/tvBody"
                app:layout_constraintEnd_toStartOf="@+id/ivTicketImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Emphasis.Heading5"/>
            <com.google.android.material.textview.MaterialTextView
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvBody"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:layout_marginHorizontal="16dp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="11sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintEnd_toStartOf="@+id/ivTicketImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHeader"
                style="@style/Android.Caption1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivTicketImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:scaleX="1.3"
                android:scaleY="1.3"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="ivTicketImage, tvBody, tvSparPrimeBody"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuy"
                android:padding="8dp"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginHorizontal="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrierContent"
                app:layout_constraintVertical_bias="1"
                app:rippleColor="@color/transparent"
                style="@style/Button.Primary40.ButtonLargeBold16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llBannerInfo"
                android:background="@drawable/bg_rounded_corners_8dp"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrierContent"
                app:layout_constraintVertical_bias="1">
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="start"
                    android:id="@+id/tvDescriptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform"
                    style="@style/Emphasis.Heading6"/>
                <com.google.android.material.textview.MaterialTextView
                    android:textColor="?attr/colorTextIcons2"
                    android:gravity="start"
                    android:id="@+id/tvDescriptionBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    style="@style/Regular.Heading7"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
