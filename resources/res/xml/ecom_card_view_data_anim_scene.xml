<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetEnd="@+id/intermediate"
        app:constraintSetStart="@+id/expand"
        app:duration="200">
        <KeyFrameSet/>
    </Transition>
    <Transition
        app:constraintSetEnd="@+id/collapse"
        app:constraintSetStart="@+id/intermediate"
        app:duration="100"
        app:motionInterpolator="easeOut">
        <KeyFrameSet/>
    </Transition>
    <ConstraintSet android:id="@+id/expand">
        <Constraint
            android:id="@+id/ecomCvdCardNumberLayout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/ecomCvdCardNumberShortText"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toEndOf="@+id/ecomCvdCardNumberLayout">
            <CustomAttribute
                app:attributeName="alpha"
                app:customFloatValue="0"/>
        </Constraint>
        <Constraint
            android:id="@+id/ecomCvdCardDateLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toStartOf="@+id/ecomCvdCardCvvLayout"
            app:layout_constraintStart_toEndOf="@+id/ecomCvdCardIconImageView"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
        <Constraint
            android:id="@+id/ecomCvdCardCvvLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/intermediate">
        <Constraint
            android:id="@+id/ecomCvdCardNumberLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:gravity="end"
            android:id="@+id/ecomCvdCardNumberShortText"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ecomCvdCardNumberLayout">
            <CustomAttribute
                app:attributeName="alpha"
                app:customFloatValue="1"/>
        </Constraint>
        <Constraint
            android:id="@+id/ecomCvdCardDateLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toStartOf="@+id/ecomCvdCardCvvLayout"
            app:layout_constraintStart_toEndOf="@+id/ecomCvdCardIconImageView"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
        <Constraint
            android:id="@+id/ecomCvdCardCvvLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/collapse">
        <Constraint
            android:id="@+id/ecomCvdCardNumberLayout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:id="@+id/ecomCvdCardNumberShortText"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintStart_toStartOf="parent"/>
        <Constraint
            android:id="@+id/ecomCvdCardDateLayout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toStartOf="@+id/ecomCvdCardCvvLayout"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
        <Constraint
            android:id="@+id/ecomCvdCardCvvLayout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/ecomCvdCardNumberLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecomCvdCardNumberLayout"/>
    </ConstraintSet>
</MotionScene>
